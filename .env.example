# Copy this file to .env (in this same folder). docker compose reads it.
#
# Server settings (database, secrets, email) are in server/.env.
# Client settings (the browser address) are in client/.env.
# Neither file is in git. Copy both by hand to each device.

# The address the browser uses to open the website.
# Same machine: keep the default.
# Another machine on your network: use this machine's IP address, and also
# set NEXT_PUBLIC_API_URL in client/.env to that IP, port 4000.
# After you change either one, run: docker compose up --build
CLIENT_ORIGIN=http://localhost:3000
