// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ── AUTH & USERS ──────────────────────────────
model User {
  id                    String               @id @default(uuid())
  email                 String               @unique
  passwordHash          String
  role                  Role
  salesRole             SalesRole?
  isActive              Boolean              @default(true)
  mustChangePassword    Boolean              @default(false)
  // Identity for an account with no Employee row — Super Admin, HR Admin and
  // Finance Officer, who otherwise have no name and no face anywhere in the
  // product and appear as a raw email address.
  //
  // Deliberately NOT used for staff: their name lives on Employee and is
  // HR's to change, which is the existing rule and not one this relaxes.
  displayName           String?
  /// Packed "publicId:version", exactly as Employee.profilePicture is.
  avatarUrl             String?
  employee              Employee?
  refreshTokens         RefreshToken[]
  passwordResetTokens   PasswordResetToken[]
  emailChangeRequests   EmailChangeRequest[]
  salesCommentsAuthored SalesComment[]
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
}

enum Role {
  SUPER_ADMIN
  HR_ADMIN
  FINANCE_OFFICER
  REPORTING_MANAGER
  EMPLOYEE
}

/// Access to the Sales Hub, held *in addition* to a person's HR role rather
/// than instead of it: an EMPLOYEE who is also a SALES_USER keeps every
/// ordinary employee permission. Null means no Sales Hub access at all.
///
/// On User and not Employee, because a Sales Admin may be a Super Admin who
/// has no Employee row (see seed.ts).
enum SalesRole {
  SALES_ADMIN
  SALES_USER
}

// Additive beyond spec §5 — see "Deviations" section, item 1.
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  // ── the session this token belongs to ──
  //
  // Rotation replaces the row on every refresh, so `id` identifies a token
  // and nothing identifies a *session*. Without this, a phone that has been
  // signed in for a fortnight looks like a new device every fifteen minutes,
  // and "where am I signed in" cannot be answered at all.
  //
  // Carried forward by `refresh()` onto the replacement row, along with
  // startedAt and userAgent. Only ever one live row per sessionId.
  sessionId  String   @default(uuid())
  /// When the session began — NOT when this token was written.
  startedAt  DateTime @default(now())
  /// Bumped on every rotation. The honest reading of "last active".
  lastUsedAt DateTime @default(now())
  /// Frozen at login: the browser does not change mid-session.
  userAgent  String?
  /// Updated on rotation, unlike userAgent — a laptop moves, and where it is
  /// *now* is what makes an unfamiliar entry worth noticing.
  ipAddress  String?

  @@index([userId, sessionId])
}

// Additive beyond spec §5 — see "Deviations" section, item 2.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

/// A self-service email change, in flight.
///
/// Two tokens, because the two questions have different answers and one link
/// cannot ask both:
///
/// - the **approve** token goes to the address on file. It answers "did the
///   person who owns this account ask for this?" — the only thing standing
///   between a borrowed session and a permanent account takeover, since
///   whoever holds the address holds password reset too.
/// - the **confirm** token goes to the new address, and is minted only once
///   the first is answered. It answers "is this inbox real and reachable?" A
///   typo that got approved would otherwise point the account at an address
///   nobody can read, locking the owner out for good.
///
/// Each catches exactly what the other misses, which is why both exist.
/// Tokens are stored hashed and never in the clear, like `PasswordResetToken`.
model EmailChangeRequest {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Lower-cased on the way in, so `Sales@` and `sales@` cannot become two
  /// accounts. Checked for collisions when requested *and* again at the end:
  /// somebody else may have taken it in between.
  newEmail String

  /// Sent to the address currently on file.
  approveTokenHash String    @unique
  approvedAt       DateTime?

  /// Minted at approval, not at request — an unapproved request must have
  /// nothing that can complete it.
  confirmTokenHash String?   @unique
  completedAt      DateTime?

  /// The owner said "this wasn't me". Uses the same approve token: whoever
  /// can approve can also refuse, and both prove the same thing.
  cancelledAt DateTime?

  /// Both stages must happen inside this window. Superseded requests are
  /// cancelled rather than left to expire, so a user has at most one live.
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// Additive beyond spec §5 — see "Deviations" section, item 5.
// Generates sequential BS-EMP-XXXXX / BS-MNG-XXXXX employee codes.
model IdCounter {
  id    String @id // "EMP" | "MNG"
  value Int    @default(0)
}

// ── EMPLOYEE ──────────────────────────────────
model Employee {
  id                 String           @id @default(uuid())
  userId             String           @unique
  user               User             @relation(fields: [userId], references: [id])
  employeeCode       String           @unique
  fullName           String
  profilePicture     String?
  dateOfBirth        DateTime?
  gender             String?
  nationalId         String?
  bloodGroup         String?
  maritalStatus      String?
  phone              String?
  presentAddress     String?
  permanentAddress   String?
  emergencyContact   String?
  designation        String
  departmentId       String
  department         Department       @relation(fields: [departmentId], references: [id])
  reportingManagerId String?
  reportingManager   Employee?        @relation("ManagerRelation", fields: [reportingManagerId], references: [id])
  subordinates       Employee[]       @relation("ManagerRelation")
  employmentType     EmploymentType
  employmentStatus   EmploymentStatus @default(ACTIVE)
  joiningDate        DateTime
  officeLocation     String?
  shiftId            String?
  shift              Shift?           @relation(fields: [shiftId], references: [id])
  // ZKTeco devices identify people by an on-device enrolment ID, not by
  // employeeCode. Unused until the hardware phase — without it, device
  // punches can't be attributed to a person.
  deviceUserId       String?          @unique
  bankAccountNumber  String?
  bankName           String?
  // BEFTN identifies the beneficiary branch by a 9-digit routing number; a
  // bank name string cannot be resolved to one. Nullable, and the bank-file
  // export refuses to emit for anyone missing it rather than producing a file
  // the bank rejects wholesale.
  bankRoutingNumber  String?
  salaryStructureId  String?
  salaryStructure    SalaryStructure? @relation(fields: [salaryStructureId], references: [id])

  // ── exit ──
  // Date-only at UTC midnight. Closes a hole with a visible symptom: the
  // attendance day grid clipped leavers at *today* because no exit date
  // existed.
  lastWorkingDay DateTime?
  // An enum, not free text: gratuity and notice-pay eligibility both depend
  // on why employment ended, and a calculation driven by free text is a
  // number somebody typed.
  exitReason     ExitReason?
  // The sentence the enum cannot hold — "60 days' notice waived by mutual
  // agreement" is exactly what a settlement dispute turns on.
  exitNote       String?

  documents     Document[]
  attendances   Attendance[]
  leaveRequests LeaveRequest[]
  leaveBalances LeaveBalance[]
  expenseClaims ExpenseClaim[]
  payslips      Payslip[]
  adjustments   PayrollAdjustment[]
  settlements   Settlement[]

  assetAssignments AssetAssignment[]
  assetRequests    AssetRequest[]
  assetRecoveries  AssetRecovery[]

  journalLines   JournalLine[]
  changeRequests EmployeeChangeRequest[]

  salesAccountsOwned       SalesAccount[]           @relation("SalesAccountOwner")
  salesAccountAssignments  SalesAccountAssignment[] @relation("SalesAccountAssignee")
  salesCommunications      SalesCommunication[]
  opportunitiesOwned       Opportunity[]            @relation("OpportunityOwner")
  weeklyReports            WeeklyReport[]
  opportunitiesWon         Opportunity[]            @relation("OpportunityWonBy")
  salesComments            SalesComment[]
  salesTargets             SalesTarget[]
  salesMeetingAttendances  SalesMeetingAttendee[]
  salesTasksAssigned       SalesTask[]              @relation("SalesTaskAssignee")
  salesTasksGiven          SalesTask[]              @relation("SalesTaskAssigner")
  salesMinutesPrepared     SalesMinutesPreparer[]
  funnelMeetingsRan        FunnelMeeting[]          @relation("FunnelMeetingRanBy")
  funnelMeetingAttendances FunnelMeetingAttendee[]  @relation("FunnelMeetingAttendee")
  funnelReviews            FunnelMeetingReview[]    @relation("FunnelMeetingReviewSubject")
}

enum EmployeeChangeField {
  // The only field this goes through today. A second value is a normal
  // migration when a second field needs the same treatment — see the doc
  // comment on EmployeeChangeRequest for why this is a closed enum rather
  // than a free String.
  NATIONAL_ID
}

enum EmployeeChangeStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

/// A change to a field the employee is not trusted to write directly,
/// submitted by them and decided by HR — the same shape AssetRequest
/// already uses for "employee asks, HR decides", not EmailChangeRequest's
/// shape, which is self-service verified by two mailed tokens with no human
/// decision at all.
///
/// At most one PENDING row per (employeeId, field): a new submission
/// supersedes — cancels — whatever was PENDING before it, rather than
/// queueing. Enforced in the service, not the schema, the same way
/// AssetRequest enforces "one open repair per asset" in code rather than a
/// constraint.
model EmployeeChangeRequest {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  field EmployeeChangeField

  /// The value at submission time, frozen — not re-read later. If HR looks
  /// at this a week on, "changed from X to Y" should describe what the
  /// employee saw when they asked, not whatever the field has drifted to
  /// since via some other path.
  oldValue String?
  newValue String

  status EmployeeChangeStatus @default(PENDING)

  decidedBy    String?
  decidedAt    DateTime?
  /// Required on REJECTED, enforced in the service — matching leave and
  /// expense rejections, which both require a note for the same reason.
  decisionNote String?

  createdAt DateTime @default(now())

  @@index([employeeId, field, status])
}

enum ExitReason {
  RESIGNATION // §27 — the worker gives notice
  RETIREMENT // §28
  TERMINATION // §26 — employer terminates with notice, no misconduct
  DISMISSAL // §23 — misconduct
  DISCHARGE // §22 — ill health, or physical/mental incapacity
  RETRENCHMENT // §20 — redundancy
  CONTRACT_END // fixed-term expiry
  DEATH
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
}

enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  RESIGNED
  TERMINATED
}

model Department {
  id            String         @id @default(uuid())
  name          String         @unique
  employees     Employee[]
  announcements Announcement[]
  assets        Asset[]

  journalLines JournalLine[]
  costNature   CostNature    @default(ADMINISTRATIVE)
}

enum DocumentType {
  CONTRACT
  NID
  CERTIFICATE
  OFFER_LETTER
  RESIGNATION
  OTHER
}

model Document {
  id         String       @id @default(uuid())
  employeeId String
  employee   Employee     @relation(fields: [employeeId], references: [id])
  // An enum, not free text. Not because it drives money — it does not — but
  // because the profile page shows *missing* document slots, and "which
  // required documents are absent" is not a question that can be asked of
  // user-typed category strings.
  type       DocumentType
  // Cloudinary asset ID. Not a URL: delivery URLs are signed per request and
  // expire after five minutes, so a stored URL would be a dead link.
  publicId   String       @unique
  // What the uploader called it. `publicId` is a UUID and unreadable; HR
  // needs to tell two certificates apart in a list.
  fileName   String
  bytes      Int
  format     String
  // User id of the HR user who uploaded it. Nullable for the same reason
  // `actorUserId` is nullable on employee events — a seeded or migrated row
  // has no actor, and "the system did it" is the honest value.
  uploadedBy String?
  uploadedAt DateTime     @default(now())

  @@index([employeeId, uploadedAt])
}

// ── LEAVE ─────────────────────────────────────

// How a type's entitlement is arrived at. The Bangladesh Labour Act 2006 does
// not use one rule for all leave: casual and sick are flat annual grants,
// earned leave is bought with days actually worked, and maternity is granted
// per occasion rather than per year.
enum LeaveAccrualBasis {
  // `annualQuota`, pro-rated across the joining year.
  PRO_RATED
  // `annualQuota` in full, per occasion. Never pro-rated — a §46 maternity
  // benefit is not smaller because the employee joined in October.
  PER_EVENT
  // §117: one day for every `EARNED_LEAVE_DAYS_PER_DAY` days actually worked
  // in the preceding twelve months, capped at `maxAccrual`, and nothing at
  // all until `minServiceMonths` of continuous service.
  EARNED
  // Zero-quota unpaid. There is no balance to run down.
  NONE
}

model LeaveType {
  id               String           @id @default(uuid())
  // Stable machine key. Every policy rule below is looked up by code, never
  // by `name` — HR renaming "Casual" to "Casual Leave" must not silently
  // switch off the §115 holiday rule attached to it.
  code             String           @unique
  name             String           @unique
  isPaid           Boolean          @default(true)
  annualQuota      Int
  carryForwardPct  Int              @default(0)
  maxConsecutive   Int?
  // Sick leave is filed after the fact — you can't schedule getting ill.
  allowsBackdating Boolean          @default(false)
  eligibleFor      EmploymentType[]

  // Granted by the Act rather than by company policy. The seed only rewrites
  // rows where this is true, so a future statutory amendment can never
  // overwrite a benefit the company chose to give on top.
  statutory        Boolean           @default(false)
  // §117(3) counts holidays falling inside earned leave as leave; §115 and
  // §116 do not, for casual and sick. So this is a per-type flag, not one
  // global rule — the same Thu–Sat range charges 3 days as earned leave and
  // 2 as casual.
  countsHolidays   Boolean           @default(false)
  accrualBasis     LeaveAccrualBasis @default(PRO_RATED)
  // §117 needs one year of continuous service; §46 maternity needs six months.
  minServiceMonths Int               @default(0)
  // Ceiling on accumulated earned leave (§117: 60 days). Null means no cap.
  maxAccrual       Int?
  // Whether a request against this type may be a half day. Company policy,
  // not statute — the Act speaks in whole days, so charging 0.5 against a
  // §115 quota is more generous than required, not a breach. False where a
  // half is incoherent: a §46 maternity benefit is not taken in halves.
  allowsHalfDay    Boolean           @default(true)

  leaveRequests LeaveRequest[]
  leaveBalances LeaveBalance[]
}

model LeaveBalance {
  id          String    @id @default(uuid())
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id])
  leaveTypeId String
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id])
  year        Int
  accrued     Float     @default(0)
  used        Float     @default(0)
  balance     Float     @default(0)
}

model LeaveRequest {
  id           String       @id @default(uuid())
  employeeId   String
  employee     Employee     @relation(fields: [employeeId], references: [id])
  leaveTypeId  String
  leaveType    LeaveType    @relation(fields: [leaveTypeId], references: [id])
  startDate    DateTime
  endDate      DateTime
  // Which half of the boundary dates the leave actually covers. A whole-day
  // request is FIRST_HALF -> SECOND_HALF, which is the pair of defaults, so
  // every row predating half-day support is already correct.
  //
  // A pair rather than one `halfDay` flag because a flag cannot say *which*
  // half, and a single `session` column cannot express a range boundary.
  // Charged days are still derived from the dates (see countChargedDays) —
  // storing a duration here would drift from the calendar the first time a
  // holiday were gazetted retroactively over an approved request.
  startSession LeaveSession @default(FIRST_HALF)
  endSession   LeaveSession @default(SECOND_HALF)
  reason       String?
  status       LeaveStatus  @default(PENDING)
  approvedBy   String?
  // Set on any terminal transition (approve/reject/cancel/revert), so a
  // decision can be audited — createdAt alone can't tell you when.
  decidedAt    DateTime?
  decisionNote String?
  createdAt    DateTime     @default(now())
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

// Which half of a working day. The boundary between the two is the shift
// midpoint, derived per date from the shift in force — never stored, so a
// dated shift override (Ramadan hours) moves it without rewriting any request.
enum LeaveSession {
  FIRST_HALF
  SECOND_HALF
}

model Holiday {
  id   String      @id @default(uuid())
  name String
  date DateTime
  type HolidayType @default(GENERAL)

  // Unique on (date, name), not on date alone: 2026-05-01 is both May Day
  // and Buddha Purnima, and a unique-on-date makes that pair unseedable.
  @@unique([date, name])
  @@index([date])
}

enum HolidayType {
  GENERAL
  EXECUTIVE_ORDER
  OPTIONAL
  // Inverts: a normal off-day declared working. The cabinet cancelled the
  // weekly holiday on 2026-05-23 when it extended Eid-ul-Azha to seven days,
  // and a calendar that can only take days away cannot express that.
  WORKING_DAY
}

// ── ATTENDANCE ────────────────────────────────

// Fills a hole the schema always had: Employee.shiftId existed with no model
// behind it. Times are "HH:mm" strings, not DateTime — a shift start is a
// time-of-day with no date and no timezone, and a DateTime would force both.
model Shift {
  id            String     @id @default(uuid())
  name          String     @unique
  startTime     String
  endTime       String
  // Lunch + breaks sit *inside* the span, so the 09:00-18:00 expectation is
  // 9 elapsed hours and nothing subtracts the break anywhere.
  breakMinutes  Int        @default(60)
  graceMinutes  Int        @default(15)
  // 0=Sun … 6=Sat. [5] is Friday.
  weeklyOffDays Int[]
  // A dated shift is a company-wide override for its window — Ramadan hours,
  // without reassigning every employee. Null/null is the standing default.
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  employees     Employee[]

  @@index([effectiveFrom, effectiveTo])
}

model Attendance {
  id          String    @id @default(uuid())
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id])
  date        DateTime
  checkIn     DateTime?
  checkOut    DateTime?
  workedHours Float?
  isLate      Boolean   @default(false)
  isEarlyOut  Boolean   @default(false)

  source AttendanceSource @default(WEB)

  approval     AttendanceApproval @default(PENDING)
  // User id of the manager or HR who decided. Every decided record has one —
  // there is no machine approval path.
  approvedBy   String?
  approvedAt   DateTime?
  approvalNote String?

  // Set when the *employee* amends their own record, flagging to the approver
  // that the time came from the person it benefits.
  regularisedAt   DateTime?
  regularisedNote String?

  // Set when the nightly job closed a day the employee left open, writing the
  // shift's end time as the check-out.
  //
  // A column of its own rather than a new `AttendanceSource`: the check-*in*
  // really was a WEB punch, and rewriting `source` would launder a true fact
  // in order to record a false one. This marks the check-out alone as
  // invented, which is what the approver needs to know — without it,
  // MISSING_CHECKOUT stops firing and the guessed time becomes invisible.
  autoCheckOutAt DateTime?

  // User id, set when HR edits the record.
  correctedBy    String?
  correctedAt    DateTime?
  correctionNote String?

  audits AttendanceAudit[]

  // Without this, a double-tapped check-in button creates two rows. It also
  // makes check-in a single atomic create instead of a read-then-write race.
  @@unique([employeeId, date])
  @@index([date])
  @@index([approval])
}

// No AUTO_APPROVED. A web punch proves identity and server time, never that
// the person was at work, so the approver's own eyes are the only real
// control — and a machine path would bypass it on exactly the records that
// look most ordinary, which is what a faked punch looks like.
enum AttendanceApproval {
  PENDING
  APPROVED
  REJECTED
}

enum AttendanceSource {
  WEB
  MANUAL
  RFID
  FACE
  FINGERPRINT
}

// correctedBy/At/Note hold only the *most recent* edit. The dispute that
// matters is always about the value before someone changed it, so every
// mutation appends here inside the same transaction.
model AttendanceAudit {
  id           String     @id @default(uuid())
  attendanceId String
  attendance   Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  action       String
  // User id of whoever performed the action.
  changedBy    String?
  changedAt    DateTime   @default(now())
  // Only the fields that changed, not whole snapshots.
  before       Json?
  after        Json?
  note         String?

  @@index([attendanceId, changedAt])
}

// ── CURRENCY ──────────────────────────────────

// An enum, not a string. There are two of them, and a free string invites
// "usd", "US$" and "Usd" — one currency silently split into three.
enum Currency {
  BDT
  USD
}

model ExchangeRate {
  id            String   @id @default(uuid())
  // Always stored in one canonical direction: base USD, quote BDT. The
  // inverse is derived as 1/rate, never stored — two rows would drift apart
  // and a BDT→USD→BDT round trip would not return the original figure.
  base          Currency
  quote         Currency
  // How many `quote` units one `base` unit buys. 1 USD = 122.500000 BDT.
  // Decimal(18,6), not (14,2): a rate is a ratio, not money, and rounding
  // 122.456789 to 122.46 is real money on a large USD payroll.
  rate          Decimal  @db.Decimal(18, 6)
  // Date-only at UTC midnight — the labelling convention leave and
  // attendance already use for a calendar date.
  effectiveFrom DateTime
  createdBy     String
  createdAt     DateTime @default(now())

  @@unique([base, quote, effectiveFrom])
  @@index([base, quote, effectiveFrom])
}

// ── PAYROLL ───────────────────────────────────
model SalaryStructure {
  id         String            @id @default(uuid())
  name       String            @unique
  // The currency `basic` and every FIXED component is denominated in.
  // Immutable after creation — changing it silently re-denominates every
  // figure. Move the employee to a different structure instead.
  currency   Currency          @default(BDT)
  basic      Decimal           @db.Decimal(14, 2)
  // A structure in use by a payslip must not be deleted; retiring it instead
  // keeps historical payslips explicable.
  isActive   Boolean           @default(true)
  components SalaryComponent[]
  employees  Employee[]
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
}

model SalaryComponent {
  id                String          @id @default(uuid())
  salaryStructureId String
  salaryStructure   SalaryStructure @relation(fields: [salaryStructureId], references: [id], onDelete: Cascade)
  // Stable machine key. Payslip breakdowns reference this, never `label`, so
  // renaming a line cannot orphan a historical figure.
  code              String
  label             String
  kind              ComponentKind
  calc              ComponentCalc
  // FIXED → an amount in the structure's currency.
  // PERCENT_OF_BASIC → percentage points, dimensionless.
  value             Decimal         @db.Decimal(10, 2)
  // Payslip display order. Ties break by code.
  sortOrder         Int             @default(0)
  // §119 leave pay and the §2(10) gratuity base. False for bonus and
  // overtime. Two consumers, so it is not speculative.
  countsAsWages     Boolean         @default(true)

  @@unique([salaryStructureId, code])
}

enum ComponentKind {
  EARNING
  DEDUCTION
}

enum ComponentCalc {
  FIXED
  PERCENT_OF_BASIC
}

model PayrollRun {
  id     String        @id @default(uuid())
  month  Int
  year   Int
  status PayrollStatus @default(DRAFT)

  // The USD→BDT rate in force at month-end, stamped at process.
  fxRateToBdt             Decimal? @db.Decimal(18, 6)
  // The rate when it was actually disbursed, if different. Reported, not
  // posted — there is no ledger for an FX gain or loss to go to.
  disbursementFxRateToBdt Decimal? @db.Decimal(18, 6)

  // Four transitions, four actors. One overwritable processedBy/At slot
  // cannot answer "who approved this?" once somebody has also disbursed it.
  processedBy   String?
  processedAt   DateTime?
  submittedBy   String?
  submittedAt   DateTime?
  approvedBy    String?
  approvedAt    DateTime?
  disbursedBy   String?
  disbursedAt   DateTime?
  // Set on a rejection back to DRAFT; required there, so "why did this come
  // back?" always has an answer.
  rejectionNote String?

  /// When a payslip email run last started. In-flight means this is set and
  /// recent — a bare boolean would wedge the run forever if a dyno died
  /// mid-send, with no way to clear it from the UI.
  emailStartedAt DateTime?

  notes     String?
  payslips  Payslip[]
  createdAt DateTime  @default(now())

  // The most important line in this file. Two runs for July means paying
  // July twice — not a data-quality problem, a double payment.
  @@unique([month, year])
}

enum PayrollStatus {
  DRAFT
  SUBMITTED
  APPROVED
  DISBURSED
}

model Payslip {
  id           String     @id @default(uuid())
  // Human-facing identifier, from IdCounter with key "PAY" — the same
  // mechanism that issues employee codes. "BS-PAY-000123". A uuid is not
  // something an employee can quote in an email.
  payslipNo    String     @unique
  payrollRunId String
  payrollRun   PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employeeId   String
  employee     Employee   @relation(fields: [employeeId], references: [id])

  // ── attendance inputs, frozen ──
  calendarDays Int
  lopDays      Decimal @db.Decimal(5, 2)
  payableDays  Decimal @db.Decimal(5, 2)

  // ── money in the payment currency, all frozen ──
  currency        Currency
  basic           Decimal  @db.Decimal(14, 2)
  grossFull       Decimal  @db.Decimal(14, 2)
  grossPay        Decimal  @db.Decimal(14, 2)
  totalDeductions Decimal  @db.Decimal(14, 2)
  netPay          Decimal  @db.Decimal(14, 2)
  // Deliberately outside grossPay: a reimbursement returns money already
  // spent, so it is not wages and must not be pro-rated by attendance.
  reimbursements  Decimal  @default(0) @db.Decimal(14, 2)
  netPayable      Decimal  @db.Decimal(14, 2)

  // ── the same four totals in the reporting currency ──
  // Exactly 1 when currency is BDT, so no branch is needed on read. This
  // duplication is part of the snapshot: a BDT figure recomputed later from
  // a changed rate would contradict the payslip it belongs to.
  fxRateToBdt        Decimal @db.Decimal(18, 6)
  grossPayBdt        Decimal @db.Decimal(14, 2)
  totalDeductionsBdt Decimal @db.Decimal(14, 2)
  netPayBdt          Decimal @db.Decimal(14, 2)
  netPayableBdt      Decimal @db.Decimal(14, 2)

  // Itemised lines, shape specified in payroll.types.ts. Json because the
  // line count varies per structure and nothing queries inside it.
  breakdown Json

  pdfUrl     String?
  emailedAt  DateTime?
  // Last failure, so a bulk send reports honestly rather than all-or-nothing.
  emailError String?

  claims      ExpenseClaim[]
  adjustments PayrollAdjustment[]

  // Reprocessing a run must not leave two payslips for the same person.
  @@unique([payrollRunId, employeeId])
  @@index([employeeId])
}

// How festival bonus is modelled, and why it is not a SalaryComponent: a
// bonus is paid twice a year, a component every month. As a component, a
// forgotten removal overpays everybody for eleven months.
model PayrollAdjustment {
  id         String        @id @default(uuid())
  employeeId String
  employee   Employee      @relation(fields: [employeeId], references: [id])
  month      Int
  year       Int
  kind       ComponentKind
  // FESTIVAL_BONUS, ARREARS, ADVANCE_RECOVERY, FESTIVAL_HOLIDAY_WAGES, …
  code       String
  label      String
  // Need not match the employee's payment currency — HR thinks in BDT, and
  // treating a 500 BDT bonus as 500 USD would be a 122× overpayment. It is
  // converted at the run's frozen rate if it differs.
  currency   Currency      @default(BDT)
  amount     Decimal       @db.Decimal(14, 2)
  // Required. An unexplained line on someone's pay is a dispute waiting.
  reason     String
  createdBy  String
  createdAt  DateTime      @default(now())
  // The idempotency guard: set when a run consumes it, so an adjustment
  // cannot be paid twice, and released when a run is reprocessed.
  payslipId  String?
  payslip    Payslip?      @relation(fields: [payslipId], references: [id])

  assetRecovery AssetRecovery?

  @@index([employeeId, year, month])
  @@index([year, month, payslipId])
}

// The shared change log. Polymorphic `entity` + `entityId` rather than one
// typed audit table per module, because the read pattern is always "what
// happened to this thing" — and it already audits employee documents,
// profiles and exits alongside payroll, which is why it is no longer named
// after payroll.
//
// AttendanceAudit deliberately stays separate: it has a real FK to
// Attendance with onDelete: Cascade, which a polymorphic table cannot
// express, and folding it in would trade an enforced constraint for a string.
model AuditLog {
  // "PAYROLL_RUN" | "PAYSLIP" | "SALARY_STRUCTURE" | "ADJUSTMENT"
  //   | "EXPENSE_CLAIM" | "SETTLEMENT" | "EXCHANGE_RATE" | "EMPLOYEE_EXIT"
  //   | "EMPLOYEE_SALARY_STRUCTURE" | "EMPLOYEE_DOCUMENT" | "EMPLOYEE_PROFILE"
  //   | "ASSET" | "ASSET_CATEGORY" | "ASSET_ASSIGNMENT" | "ASSET_REQUEST"
  //   | "ASSET_REPAIR" | "COST" | "COST_COMMITMENT" | "COST_CATEGORY"
  //   | "DEPARTMENT" | "SHIFT" | "LEAVE_TYPE"
  //
  // The authority is `AuditEntity` in src/utils/audit.ts; this is a reader's
  // convenience and has drifted before.
  id        String   @id @default(uuid())
  entity    String
  entityId  String
  // CREATE | PROCESS | SUBMIT | APPROVE | REJECT | DISBURSE | PAY | UPDATE
  //   | DELETE | ASSIGN | ACKNOWLEDGE | RETURN | SEND_REPAIR | RECEIVE_REPAIR
  //   | RETIRE | MARK_LOST | FULFIL | IMPORT | CANCEL
  action    String
  changedBy String?
  changedAt DateTime @default(now())
  // Only the fields that changed, not whole snapshots.
  before    Json?
  after     Json?
  note      String?

  @@index([entity, entityId, changedAt])
  @@index([changedAt])
}

/// Every email this server has attempted to send.
///
/// A log, not a queue: nothing retries a failed row automatically. A failure
/// is visible on /admin/emails and is resent from the page that owns the
/// thing — the payroll run page for payslips, Reissue credentials for logins.
model EmailDispatch {
  id        String    @id @default(uuid())
  // The recipient at send time. Denormalised on purpose: this log answers
  // "where did it actually go", and a join to User would answer "where would
  // it go now" — a different question after an address change.
  to        String
  // The authority is `DispatchKind` in src/utils/mailer.ts.
  kind      String
  subject   String
  // What the email was about. Same polymorphic pair as AuditLog, and nullable
  // for the same reason: a password-reset email is about nothing but a person.
  entity    String?
  entityId  String?
  // Both null means the process died before the send resolved; sentAt means
  // the mail server accepted it; error means it refused. Three states, because
  // a boolean cannot tell a crashed dyno from a clean success.
  sentAt    DateTime?
  error     String?
  createdAt DateTime  @default(now())

  @@index([createdAt])
  @@index([kind, createdAt])
  @@index([entity, entityId])
}

model ExpenseClaim {
  id                 String          @id @default(uuid())
  employeeId         String
  employee           Employee        @relation(fields: [employeeId], references: [id])
  amount             Decimal         @db.Decimal(14, 2)
  categoryId         String
  category           ExpenseCategory @relation(fields: [categoryId], references: [id])
  legacyCategoryText String?
  /// What this claim is, in a few words — "Water jar", "Taxi to Motijheel".
  ///
  /// A category alone cannot tell two claims apart: three things filed under
  /// "Other" in one month are three identical rows, and the description was
  /// being pressed into service as a name because there was nothing else.
  ///
  /// Nullable only because claims already exist. The create validator requires
  /// it, and the migration backfills the column from `description`, which is
  /// exactly what people had been putting there.
  name               String?
  description        String?
  /// Superseded by `ExpenseAttachment`. Kept because claims already carry
  /// links people pasted, and dropping the column would erase the only
  /// evidence behind an approved claim. Write path is closed; reads still
  /// show it.
  receiptUrl         String?
  status             ExpenseStatus   @default(PENDING)

  /// Where a journey started and ended. Nullable and free text, because only
  /// travel and conveyance claims have a route at all, and "Gulshan 1 to
  /// Motijheel" is what an approver needs — not a place entity nobody
  /// maintains.
  travelFrom String?
  travelTo   String?

  // When the money was spent — distinct from when it was claimed. You submit
  // a July taxi fare in August, and it must be judged on the July date.
  expenseDate DateTime
  // What it was spent in. This is the main real-world USD case: someone
  // travels and pays in dollars while drawing a BDT salary.
  currency    Currency @default(BDT)
  // The rate in force on `expenseDate`, frozen at approval — not the run's
  // rate. What someone is owed for an $80 spend on 3 July is what $80 was
  // worth on 3 July, not what it is worth whenever approval happened.
  fxRateToBdt Decimal? @db.Decimal(18, 6)

  reviewedBy String?
  reviewedAt DateTime?
  // Required on reject, matching leave and attendance.
  reviewNote String?

  // Which payslip actually paid it. Without this, REIMBURSED is a label
  // somebody set, not a fact anyone can check against a bank file.
  payslipId    String?
  payslip      Payslip?    @relation(fields: [payslipId], references: [id])
  // Or which settlement paid it, for a claim outstanding when someone left.
  settlementId String?
  settlement   Settlement? @relation(fields: [settlementId], references: [id])

  attachments ExpenseAttachment[]

  createdAt DateTime @default(now())

  @@index([status])
  @@index([employeeId, status])
  /// The date-range report reads by spend date, not by claim date.
  @@index([expenseDate])
}

/// A receipt on a claim. Mirrors `CostAttachment` exactly — same single owner,
/// same `publicId`-not-URL rule, same cascade — because a receipt on a staff
/// claim and a receipt on a company bill are the same object with a different
/// parent.
model ExpenseAttachment {
  id      String       @id @default(uuid())
  claimId String
  claim   ExpenseClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  // Cloudinary asset ID, not a URL — delivery URLs are signed per request
  // and expire, so a stored URL would be a dead link.
  publicId   String   @unique
  fileName   String
  bytes      Int
  format     String
  uploadedBy String?
  uploadedAt DateTime @default(now())

  @@index([claimId, uploadedAt])
}

// REIMBURSED is a transition the *system* makes when a run or a settlement
// consumes the claim, never one a human sets by hand. That is the difference
// between a workflow and a status field.
enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
  REIMBURSED
}

// ── SETTLEMENT ────────────────────────────────

// The source spec's version is four money fields and a timestamp — it
// describes a *number*, not a document somebody approves and somebody else
// pays. The additions mirror PayrollRun deliberately: same shape of problem,
// so it needs no second mental model.
model Settlement {
  id           String           @id @default(uuid())
  settlementNo String           @unique
  employeeId   String
  employee     Employee         @relation(fields: [employeeId], references: [id])
  status       SettlementStatus @default(DRAFT)

  // ── exit facts, copied in and frozen at calculation ──
  lastWorkingDay DateTime
  exitReason     ExitReason
  // Completed years of continuous service, to 2dp. Drives gratuity.
  serviceYears   Decimal    @db.Decimal(5, 2)

  currency    Currency
  fxRateToBdt Decimal  @db.Decimal(18, 6)

  // ── heads, in `currency` ──
  pendingSalary         Decimal @db.Decimal(14, 2)
  gratuity              Decimal @default(0) @db.Decimal(14, 2)
  noticePay             Decimal @default(0) @db.Decimal(14, 2)
  expenseReimbursement  Decimal @default(0) @db.Decimal(14, 2)
  // Kept and always written 0 this phase. Dropping and re-adding a money
  // column on a paid document is worse than a zero.
  leaveEncashment       Decimal @default(0) @db.Decimal(14, 2)
  outstandingDeductions Decimal @default(0) @db.Decimal(14, 2)
  // Its own head rather than folded into outstandingDeductions, which posts
  // entirely to ADVANCE_RECOVERY → 1250 Employee Advances. Nothing was ever
  // advanced for a lost laptop, so there is no receivable to clear, and
  // folding it in would credit an asset account that was never debited.
  assetRecoveries       Decimal @default(0) @db.Decimal(14, 2)
  finalAmount           Decimal @db.Decimal(14, 2)
  finalAmountBdt        Decimal @db.Decimal(14, 2)

  breakdown Json

  // Same separation of duties as a run: Finance calculates, Super Admin
  // approves and cannot be calculatedBy, Finance pays.
  calculatedBy  String?
  calculatedAt  DateTime?
  approvedBy    String?
  approvedAt    DateTime?
  paidBy        String?
  paidAt        DateTime?
  rejectionNote String?

  pdfUrl      String?
  emailedAt   DateTime?
  generatedAt DateTime  @default(now())

  claims            ExpenseClaim[]
  assetRecoveryRows AssetRecovery[]

  @@index([employeeId])
  @@index([status])
}

enum SettlementStatus {
  DRAFT
  APPROVED
  PAID
}

// ── REPORTING & COMMUNICATION ─────────────────
model Announcement {
  id          String @id @default(uuid())
  title       String
  body        String
  // User id of the publisher.
  publishedBy String

  // An enum plus two nullable targets, not a String. A free string invites
  // "All employees", "all", "ALL" and "Product team" — and the last cannot be
  // resolved to a department without string-matching a name HR may rename.
  audience     AnnouncementAudience @default(ALL)
  departmentId String?
  department   Department?          @relation(fields: [departmentId], references: [id])
  targetRole   Role?

  // Null = draft. Future = scheduled. Past = live. Every read filters
  // `publishedAt <= now()`, so scheduling falls out of the read rather than
  // needing a cron job that silently fails to announce something on payday if
  // it misses a tick.
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([publishedAt])
}

enum AnnouncementAudience {
  ALL
  DEPARTMENT
  ROLE
}

// ── EVENT LOG ─────────────────────────────────

// One row per user action, feeding every activity feed and — later — the
// notification system. Deliberately *not* the audit log: `AuditLog` and
// `AttendanceAudit` write one row per record, so bulk-approving a fortnight
// for sixteen people is 160 audit rows and exactly one event. Both are
// correct; they answer different questions.
//
// **No foreign keys** to Employee or User, on purpose. An event is a
// historical record and must outlive the rows it refers to — a cascade
// delete that silently erases the log of what someone did is the opposite of
// what a log is for. `title`/`meta` are frozen at emit precisely so reads
// never need to join back to those ids.
model Event {
  id String @id @default(uuid())

  // Machine key: "leave.approved". A String with a TS union in front of it,
  // not an enum — matching AuditLog.entity, which took the same decision
  // for the same reason. A new event type is a deploy, not a migration.
  type     String
  severity EventSeverity @default(INFO)

  // Who did it. Null means the system did.
  actorUserId String?

  // What it is about, polymorphic exactly as AuditLog is.
  entity   String
  entityId String

  // ── audience, resolved at emit ──
  subjectEmployeeId    String?
  // The subject's manager, frozen at emit rather than joined at read: the
  // read becomes an indexed equality instead of a subquery, and the person
  // notified stays whoever was their manager when it happened.
  managerEmployeeId    String?
  targetRoles          Role[]
  companyWide          Boolean @default(false)
  // A whole department, which a department-scoped announcement needs. A
  // plain id rather than a relation, for the same reason nothing else here
  // is one: the event must outlive the row. Storing the audience as a rule
  // keeps a 200-person department one insert instead of 200.
  audienceDepartmentId String?

  // ── presentation, frozen at emit ──
  title   String
  meta    String?
  href    String?
  // The facts behind the rendered strings, kept alongside rather than
  // instead: an email template needs more than a feed line, and a
  // notification must not have to parse `title` back apart.
  payload Json?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([subjectEmployeeId, createdAt])
  @@index([managerEmployeeId, createdAt])
  @@index([audienceDepartmentId, createdAt])
  @@index([entity, entityId, createdAt])
}

enum EventSeverity {
  INFO
  SUCCESS
  WARNING
  ERROR
}

// ── ASSETS ────────────────────────────────────

enum AssetClassification {
  IT
  NON_IT
}

model AssetCategory {
  id   String @id @default(uuid())
  // Stable machine key (LAPTOP, MONITOR, PHONE, FURNITURE, VEHICLE, LICENCE).
  // Rules key off this, never off `name`.
  code String @unique
  name String @unique

  // A laptop has a serial; a chair does not. Enforced at create rather than
  // being a nullable field everyone forgets.
  requiresSerial Boolean             @default(true)
  // Issued and never expected back — a mouse, a keyboard, a headset. Excluded
  // from the exit checklist.
  isConsumable   Boolean             @default(false)
  // IT or non-IT, stated once per category. A property of the kind of thing,
  // never of a single asset and never of a request — a chair is non-IT no
  // matter who asks for it or why. Non-null deliberately: a nullable column
  // creates a silent "unclassified" bucket nobody ever goes back and fills,
  // and then every IT/non-IT filter lies by omission.
  classification AssetClassification

  // False means requestable but never registered — paper, pens, printer ink.
  // Distinct from isConsumable, which means "never expected back" but is still
  // one row with its own tag (a mouse). A pen is neither.
  tracksIndividually Boolean @default(true)
  // Straight-line life. Unused in phase 1; the book-value report is phase 2.
  // The column exists now so the importer can carry it and there is no second
  // migration to backfill it later.
  usefulLifeMonths   Int?

  assets   Asset[]
  requests AssetRequest[]
}

model Asset {
  id           String        @id @default(uuid())
  // Human-facing tag from IdCounter with a new key "AST" — the mechanism
  // already issuing employee codes. "BS-AST-00123".
  assetTag     String        @unique
  categoryId   String
  category     AssetCategory @relation(fields: [categoryId], references: [id])
  name         String
  // Unique when present. Two assets cannot share a serial, but many rows
  // legitimately have none (furniture, licences) and Postgres permits
  // multiple nulls under a unique constraint.
  serialNumber String?       @unique
  model        String?
  notes        String?

  // ── acquisition ──
  purchaseDate   DateTime?
  purchaseCost   Decimal?  @db.Decimal(14, 2)
  // Payroll's Currency enum. Imported hardware is priced in USD, and a second
  // currency enum would be a second thing to keep in step.
  currency       Currency  @default(BDT)
  vendor         String?
  warrantyExpiry DateTime?

  // ── ledger (phase 2) ──
  // Frozen at capitalisation, and 1.000000 for a BDT asset. Everything the
  // ledger sees derives from purchaseCostBdt; nothing reconverts, ever.
  // Operating costs lack this column, which is exactly why USD costs cannot
  // post at all.
  fxRateToBdt     Decimal?  @db.Decimal(18, 6)
  purchaseCostBdt Decimal?  @db.Decimal(14, 2)
  capitalisedAt   DateTime?
  capitalisedBy   String?

  depreciationCharges AssetDepreciation[]

  // ── where it belongs, as distinct from who is holding it ──
  // The owning cost centre. NOT the holder's department — a laptop bought by
  // Engineering can be lent to Sales without changing which budget owns it.
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  // Where it physically sits when nobody has it. "Store room B, shelf 3".
  location     String?

  // ── lifecycle: only the irreversible decisions are stored ──
  lifecycle      AssetLifecycle @default(IN_SERVICE)
  retiredAt      DateTime?
  retiredBy      String? // User id
  retirementNote String?

  assignments       AssetAssignment[]
  repairs           AssetRepair[]
  requests          AssetRequest[]    @relation("RequestTarget")
  fulfilledRequests AssetRequest[]    @relation("RequestFulfilment")
  attachments       AssetAttachment[]
  recoveries        AssetRecovery[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([lifecycle])
}

// ── ledger (phase 2) ──
// Frozen at capitalisation, and 1.000000 for a BDT asset. Everything the
// ledger sees derives from purchaseCostBdt; nothing reconverts, ever.
// Operating costs lack this column, which is exactly why USD costs cannot
// post at all.
model DepreciationRun {
  id     String                @id @default(uuid())
  // IdCounter key "DEP" — the mechanism already issuing journal and employee
  // numbers. "BS-DEP-00007".
  runNo  String                @unique
  year   Int
  month  Int
  status DepreciationRunStatus @default(DRAFT)

  // The journal this run produced. Null while DRAFT; kept after a reversal so
  // the reversal has something to name.
  journalId String?
  journal   Journal? @relation(fields: [journalId], references: [id])

  createdBy  String
  createdAt  DateTime  @default(now())
  postedBy   String?
  postedAt   DateTime?
  reversedBy String?
  reversedAt DateTime?

  charges AssetDepreciation[]

  // One run per month. A second attempt collides here rather than
  // double-charging, which is the whole idempotency guard.
  @@unique([year, month])
  @@index([status])
}

model AssetDepreciation {
  id      String          @id @default(uuid())
  runId   String
  run     DepreciationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  assetId String
  asset   Asset           @relation(fields: [assetId], references: [id])

  // Always BDT. A USD asset is converted once, at capitalisation, and never
  // again — see spec Decision 7.
  amount Decimal @db.Decimal(14, 2)

  // The figures the charge was computed from, frozen. Without them a rate
  // change six months from now silently rewrites history when somebody
  // recomputes to check.
  openingBookValue Decimal @db.Decimal(14, 2)
  rate             Decimal @db.Decimal(5, 2)
  // How many months this charge covers. 1 normally; more when a late
  // capitalisation is caught up — see spec Decision 6.
  months           Int     @default(1)

  @@unique([runId, assetId])
  @@index([assetId])
}

enum DepreciationRunStatus {
  DRAFT
  POSTED
  REVERSED
}

enum AssetRecoveryKind {
  NOT_RETURNED
  DAMAGED
  LOST
}

enum AssetRecoveryStatus {
  PENDING
  RECOVERED
  WAIVED
}

model AssetRecovery {
  id           String           @id @default(uuid())
  assetId      String
  asset        Asset            @relation(fields: [assetId], references: [id])
  employeeId   String
  employee     Employee         @relation(fields: [employeeId], references: [id])
  // The custody episode it arose under. Nullable because an asset can go
  // missing with nobody holding it, and because a recovery may be raised
  // after the assignment has been closed out.
  assignmentId String?
  assignment   AssetAssignment? @relation(fields: [assignmentId], references: [id])

  kind     AssetRecoveryKind
  // Typed by a person, never computed. Book value, replacement cost and
  // original cost are three defensible answers and the system cannot see
  // which one applies.
  amount   Decimal           @db.Decimal(14, 2)
  currency Currency          @default(BDT)
  // Required, and required non-empty. An unexplained deduction from
  // somebody's pay is a dispute waiting.
  reason   String

  status AssetRecoveryStatus @default(PENDING)

  // A waived recovery is kept, never deleted. "We chose not to charge her" is
  // precisely what an auditor asks about, and a deleted row cannot answer.
  waivedBy     String?
  waivedAt     DateTime?
  waiverReason String?

  // One recovery, one deduction — enforced by the database rather than by a
  // service that remembers to check.
  adjustmentId String?            @unique
  adjustment   PayrollAdjustment? @relation(fields: [adjustmentId], references: [id])
  // Not unique: one settlement legitimately clears several recoveries.
  settlementId String?
  settlement   Settlement?        @relation(fields: [settlementId], references: [id])

  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId, status])
  @@index([assetId])
}

enum AssetLifecycle {
  IN_SERVICE
  LOST
  RETIRED
}

enum AssetCondition {
  NEW
  GOOD
  FAIR
  DAMAGED
}

model AssetAssignment {
  id         String   @id @default(uuid())
  assetId    String
  asset      Asset    @relation(fields: [assetId], references: [id])
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  assignedAt     DateTime
  assignedBy     String // User id — who handed it over
  conditionOut   AssetCondition
  issueNote      String?
  // The employee's own confirmation. Null means HR says they have it and the
  // employee has not said so.
  acknowledgedAt DateTime?

  returnedAt  DateTime?
  returnedTo  String? // User id — who received it back
  conditionIn AssetCondition?
  returnNote  String?

  attachments AssetAttachment[]
  recoveries  AssetRecovery[]

  @@index([assetId, assignedAt])
  @@index([employeeId, returnedAt])
}

model AssetAttachment {
  id           String           @id @default(uuid())
  // Exactly one of these is set — an asset-level file (photo, invoice,
  // warranty) or a handover-level one (condition photos). Prisma cannot
  // express that, so the migration hand-writes a CHECK constraint alongside
  // the partial unique index it is already hand-writing:
  //   CHECK (("assetId" IS NULL) <> ("assignmentId" IS NULL))
  // A service guard alone would leave the invariant true only for as long as
  // every future caller remembers it.
  assetId      String?
  asset        Asset?           @relation(fields: [assetId], references: [id], onDelete: Cascade)
  assignmentId String?
  assignment   AssetAssignment? @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  kind AssetAttachmentKind

  // Cloudinary asset ID, not a URL — delivery URLs are signed per request and
  // expire, so a stored URL would be a dead link. Same reasoning as Document.
  publicId   String   @unique
  fileName   String
  bytes      Int
  format     String
  uploadedBy String?
  uploadedAt DateTime @default(now())

  @@index([assetId, uploadedAt])
  @@index([assignmentId, uploadedAt])
}

enum AssetAttachmentKind {
  PHOTO
  INVOICE
  WARRANTY
  CONDITION_OUT
  CONDITION_IN
}

enum AssetRequestKind {
  NEW_ITEM
  REPAIR
  RETURN
}

// PENDING/APPROVED/REJECTED/CANCELLED mirror LeaveStatus deliberately — the
// same workflow shape should not need a second vocabulary. FULFILLED is the
// one addition, because an approved request that nothing was issued against
// is not finished.
enum AssetRequestStatus {
  PENDING
  APPROVED
  ORDERED
  REJECTED
  CANCELLED
  FULFILLED
}

model AssetRequest {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  kind AssetRequestKind @default(NEW_ITEM)

  // NEW_ITEM names a category, not a unit — you ask for "a monitor", not
  // BS-AST-00042. REPAIR and RETURN name the specific asset the requester
  // holds. Exactly one of the two is set, enforced by a CHECK the service
  // also validates so the failure is a sentence rather than a 500.
  categoryId String?
  category   AssetCategory? @relation(fields: [categoryId], references: [id])
  assetId    String?
  asset      Asset?         @relation("RequestTarget", fields: [assetId], references: [id])

  // Supplies only. A tracked request is strictly one-to-one, because
  // fulfilment writes one fulfilledAssetId and an assignment is one asset to
  // one person.
  quantity Int?

  reason String
  status AssetRequestStatus @default(PENDING)

  decidedBy    String?
  decidedAt    DateTime?
  decisionNote String?

  // Someone went shopping. Deliberately carries no estimated cost: the real
  // figure lands on the Asset at creation and two cost fields invite a
  // reconciliation nobody performs.
  orderedAt  DateTime?
  orderedBy  String?
  expectedBy DateTime?
  orderNote  String?

  // The repair this request created on approval. One repair per request.
  repairId String?      @unique
  repair   AssetRepair? @relation(fields: [repairId], references: [id])

  fulfilledAt      DateTime?
  fulfilledBy      String?
  fulfilledAssetId String?
  fulfilledAsset   Asset?    @relation("RequestFulfilment", fields: [fulfilledAssetId], references: [id])
  fulfilledNote    String?

  createdAt DateTime @default(now())

  @@index([status])
  @@index([employeeId, createdAt])
  @@index([kind, status])
}

model AssetRepair {
  id      String @id @default(uuid())
  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id])

  sentAt       DateTime
  sentBy       String // User id
  vendor       String?
  fault        String
  expectedBack DateTime?
  isWarranty   Boolean   @default(false)

  returnedAt     DateTime?
  // Expense, not capitalised. Never enters the depreciation base.
  cost           Decimal?        @db.Decimal(14, 2)
  currency       Currency        @default(BDT)
  outcome        String?
  // A repair that comes back unrepairable is how an asset reaches RETIRED or
  // LOST, but the transition is a separate explicit act.
  conditionAfter AssetCondition?

  // The request that created this repair on approval. One repair per request.
  request AssetRequest?

  @@index([assetId, sentAt])
  @@index([returnedAt])
}

model CostCategory {
  id   String @id @default(uuid())
  // Stable machine key. Rules key off this, never off `name`.
  code String @unique
  name String @unique

  costs       OperatingCost[]
  commitments CostCommitment[]
}

model CostCommitment {
  id         String       @id @default(uuid())
  categoryId String
  category   CostCategory @relation(fields: [categoryId], references: [id])

  // "Office rent — Banani", "Rahima (cleaning)".
  label String
  // The landlord, the provider, the person. A string: vendor management as
  // an entity is a different module, and this needs a name on a payment.
  payee String

  // Nullable on purpose. Rent and wifi are fixed; electricity and water are
  // not, and a fixed figure on a variable bill is a number that is wrong
  // eleven months a year.
  amount   Decimal? @db.Decimal(14, 2)
  currency Currency @default(BDT)
  // Day of month, 1-31. Nullable — not everything has one.
  dueDay   Int?

  startedOn DateTime
  // Null means still running. A commitment is never deleted: it ended, and
  // the bills it explains still exist.
  endedOn   DateTime?
  notes     String?

  costs OperatingCost[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
}

model OperatingCost {
  id           String          @id @default(uuid())
  categoryId   String
  category     CostCategory    @relation(fields: [categoryId], references: [id])
  commitmentId String?
  commitment   CostCommitment? @relation(fields: [commitmentId], references: [id])

  label String
  payee String

  // The month this bill is FOR, deliberately distinct from when it was paid.
  // July's electricity paid in August is a July cost; conflating the two
  // makes every monthly total wrong at the boundaries. Same distinction
  // ExpenseClaim already draws between expenseDate and the claim date.
  periodMonth Int
  periodYear  Int

  amount   Decimal   @db.Decimal(14, 2)
  currency Currency  @default(BDT)
  dueDate  DateTime?

  status     CostStatus @default(PENDING)
  paidAt     DateTime?
  paidBy     String? // User id
  // Cheque number, bank reference, bKash transaction id. A payment nobody
  // can trace back to a bank statement is a payment nobody can verify.
  paymentRef String?

  notes       String?
  attachments CostAttachment[]

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One January rent, not two. Only binds commitment-linked bills, since
  // Postgres permits many nulls under a unique constraint — which is the
  // right scope: ad-hoc one-off costs have no period to collide on.
  @@unique([commitmentId, periodYear, periodMonth])
  @@index([periodYear, periodMonth])
  @@index([status])
  @@index([categoryId])
}

// Two values, because those are the only two facts. "Overdue" is derived
// from dueDate on read (Decision 5) — the same derive-don't-store rule the
// asset module is built on.
enum CostStatus {
  PENDING
  PAID
}

model CostAttachment {
  id     String        @id @default(uuid())
  costId String
  cost   OperatingCost @relation(fields: [costId], references: [id], onDelete: Cascade)

  // Cloudinary asset ID, not a URL — delivery URLs are signed per request
  // and expire, so a stored URL would be a dead link. Same as Document and
  // AssetAttachment.
  publicId   String   @unique
  fileName   String
  bytes      Int
  format     String
  uploadedBy String?
  uploadedAt DateTime @default(now())

  @@index([costId, uploadedAt])
}

// ── ACCOUNTING ────────────────────────────────

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

// What makes an account appear in the Cash Book or the Bank Book. Both are
// the General Ledger filtered to these, not separate stores.
enum AccountCashKind {
  NONE
  CASH
  BANK
}

enum CashFlowKind {
  NONE
  CASH
  OPERATING_WC
  NON_CASH_ADDBACK
  INVESTING
  FINANCING
}

model Account {
  id   String      @id @default(uuid())
  // Four digits. The first digit is fixed by `type`: 1 ASSET, 2 LIABILITY,
  // 3 EQUITY, 4 INCOME, 5 EXPENSE — validated on write. This is why the
  // trial balance sorts into statement order on `code` alone, and why an
  // expense account can never be coded 1300.
  code String      @unique
  name String
  type AccountType

  parentId String?
  parent   Account?  @relation("AccountTree", fields: [parentId], references: [id])
  children Account[] @relation("AccountTree")

  // A group header. A journal line pointing at a group is rejected.
  //
  // Stored, not derived from "has children": a leaf with no children yet is
  // not the same thing as a header, and if it were derived, adding the first
  // child to a leaf would silently invalidate every line already posted to it.
  isGroup Boolean @default(false)

  cashKind AccountCashKind @default(NONE)

  // Retired, not deleted, once it carries a line.
  isActive Boolean @default(true)

  // Set only on the accounts the engine and the statements must find by role
  // rather than by code, so a renumbered chart breaks nothing. Twelve of the
  // thirteen are level-2 *groups*: they carry the statement structure and the
  // leaves under them carry none of it.
  //
  //   NON_CURRENT_ASSETS · CURRENT_ASSETS · CURRENT_LIABILITIES
  //   NON_CURRENT_LIABILITIES · PPE_COST · PPE_ACCUM_DEP
  //   REVENUE · OTHER_INCOME · COST_OF_SALES · ADMIN_SELLING
  //   FINANCIAL_EXPENSE · TAX_EXPENSE
  //   RETAINED_EARNINGS (the one leaf with a role)
  //
  // The equity section needs no role: `type: EQUITY` already identifies it.
  systemRole String? @unique

  description String?

  noteRef          String?
  cashFlowKind     CashFlowKind @default(NONE)
  depreciationRate Decimal?     @db.Decimal(5, 2)
  contraAccountId  String?      @unique
  contra           Account?     @relation("AccountContra", fields: [contraAccountId], references: [id])
  contraOf         Account?     @relation("AccountContra")

  lines        JournalLine[]
  postingRules PostingRule[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([type, code])
  @@index([parentId])
  @@index([noteRef])
  @@index([cashFlowKind])
}

model FinancialYear {
  id        String              @id @default(uuid())
  name      String              @unique // "FY 2026-27"
  startDate DateTime // 1 Jul, UTC midnight
  endDate   DateTime // 30 Jun
  status    FinancialYearStatus @default(OPEN)

  periods AccountingPeriod[]

  closedBy  String?
  closedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([startDate])
}

enum FinancialYearStatus {
  OPEN
  CLOSED // year-end journal posted; every period LOCKED
}

model AccountingPeriod {
  id              String        @id @default(uuid())
  financialYearId String
  financialYear   FinancialYear @relation(fields: [financialYearId], references: [id], onDelete: Cascade)

  // Calendar month and year, so FY 2026-27 spans 7/2026 … 6/2027. Not an
  // ordinal 1-12 within the year: every consumer has a real date and would
  // have to convert.
  month     Int
  year      Int
  startDate DateTime
  endDate   DateTime

  status PeriodStatus @default(OPEN)

  closedBy     String?
  closedAt     DateTime?
  reopenedBy   String?
  reopenedAt   DateTime?
  // Required on reopen. An unexplained reopen of a closed month is the first
  // thing an auditor asks about.
  reopenReason String?

  journals Journal[]

  @@unique([year, month])
  @@index([financialYearId])
}

enum PeriodStatus {
  OPEN
  CLOSED // Super Admin may reopen, with a reason, audited
  LOCKED // permanent, set by year-end
}

model Journal {
  id        String @id @default(uuid())
  // "BS-JV-00123", issued from IdCounter with key "JV" — the same mechanism
  // that issues employee codes and asset tags.
  journalNo String @unique

  // The transaction date. It alone decides which period the journal falls
  // into, and it is the date every ledger, book and statement reports
  // against. There is deliberately no second "posting date" field: that
  // value is `postedAt`, a timestamp recording when a human approved it,
  // not an accounting date.
  date     DateTime
  periodId String
  period   AccountingPeriod @relation(fields: [periodId], references: [id])

  type   JournalType   @default(MANUAL)
  status JournalStatus @default(DRAFT)

  // Required. "Salary accrual for July 2026." A journal nobody can read is a
  // journal nobody can audit.
  narration String
  // Cheque number, bank reference, invoice number. Free text, optional.
  reference String?

  // ── the seam every future module posts through ──
  sourceModule String? // "PAYROLL" | "EXPENSE" | "COST" | "SETTLEMENT" | …
  sourceRefId  String? // the PayrollRun id, the ExpenseClaim id, …
  // Which event on that record. One payroll run legitimately produces two
  // journals — the accrual and the payment — and this is what keeps them
  // distinct while each stays individually idempotent.
  sourceEvent  String?

  createdBy     String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  submittedBy   String?
  submittedAt   DateTime?
  approvedBy    String?
  approvedAt    DateTime?
  postedAt      DateTime?
  // Set on a rejection back to DRAFT; required there, matching PayrollRun.
  rejectionNote String?

  // Reversal pairing, navigable both ways. @unique enforces that a journal
  // is reversed at most once.
  reversesId     String?  @unique
  reverses       Journal? @relation("Reversal", fields: [reversesId], references: [id])
  reversedBy     Journal? @relation("Reversal")
  reversalReason String?

  lines       JournalLine[]
  attachments JournalAttachment[]

  depreciationRuns DepreciationRun[]

  // The idempotency guard, and the reason the payroll seam needs no new
  // schema in slice 3. Postgres permits unlimited all-null rows under a
  // unique constraint, so manual journals (all three null) are
  // unconstrained while a payroll run physically cannot accrue twice. The
  // same trick OperatingCost already uses for
  // [commitmentId, periodYear, periodMonth].
  @@unique([sourceModule, sourceRefId, sourceEvent])
  @@index([date])
  @@index([status])
  @@index([periodId])
  @@index([type])
}

enum JournalType {
  OPENING // the one opening-balance journal per financial year
  MANUAL // typed by a human
  SYSTEM // generated by another module — slice 3 onward
  REVERSAL
  CLOSING // year-end: P&L accounts → Retained Earnings
}

// REJECTED is deliberately absent. A rejection returns the journal to DRAFT
// with a rejectionNote, exactly as PayrollRun does.
enum JournalStatus {
  DRAFT
  PENDING_APPROVAL
  POSTED
  REVERSED
}

model JournalLine {
  id        String  @id @default(uuid())
  journalId String
  journal   Journal @relation(fields: [journalId], references: [id], onDelete: Cascade)
  accountId String
  account   Account @relation(fields: [accountId], references: [id])

  // Exactly one is non-zero. Two columns rather than one signed amount
  // because that is how a ledger is read and printed, and because it turns
  // the balance rule into a single SUM(debit) = SUM(credit) aggregate rather
  // than a sign-dependent one. Always BDT.
  debit  Decimal @default(0) @db.Decimal(14, 2)
  credit Decimal @default(0) @db.Decimal(14, 2)

  // Per-line note, distinct from the journal's narration.
  narration String?

  // ── analytical dimensions, both optional ──
  // Two nullable FKs to masters that already exist. Together they give a
  // ledger filtered by department and the Employee Ledger, with no new
  // master data. Branch, cost centre and project are deliberately absent.
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  employeeId   String?
  employee     Employee?   @relation(fields: [employeeId], references: [id])

  // ── provenance of a converted figure, memo only ──
  // Null when the transaction was already BDT. Nothing computes from these;
  // they exist so a ledger line reading 61,25,000 can answer "why?" with
  // "USD 50,000 at 122.50".
  sourceCurrency Currency?
  sourceAmount   Decimal?  @db.Decimal(14, 2)
  fxRateToBdt    Decimal?  @db.Decimal(18, 6)

  // ── deal-based dimensions, added for receivables & payables ──
  // Same pattern as departmentId/employeeId above: optional, so nothing
  // that already posts has to change. A line carries at most one of
  // customerId/supplierId in practice, never both, but nothing here
  // enforces that — the posting builders that create these lines are
  // what guarantee it (Phase 2/3), the same way nothing on this model
  // enforces "exactly one of debit/credit is non-zero" either.
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id])
  customerId    String?
  customer      Customer?    @relation(fields: [customerId], references: [id])
  supplierId    String?
  supplier      Supplier?    @relation(fields: [supplierId], references: [id])

  sortOrder Int @default(0)

  @@index([accountId])
  @@index([journalId])
  @@index([employeeId])
  @@index([departmentId])
  @@index([opportunityId])
  @@index([customerId])
  @@index([supplierId])
}

// ── RECEIVABLES & PAYABLES — Phase 1 ────────────────────────────────────────

model Customer {
  id String @id @default(uuid())

  // Optional: set when a Customer is created from a Won Opportunity
  // (Phase 3). Opening-balance imports create Customers with no Sales
  // Account behind them — pre-existing debtors this system never quoted.
  salesAccountId String?       @unique
  salesAccount   SalesAccount? @relation(fields: [salesAccountId], references: [id])

  // Required before the first invoice is approved (Phase 3 enforces this,
  // not this model) — a Mushak 6.3 tax invoice needs both parties' names.
  // Unique so the opening-balance importer (customer.opening-balance.import.ts)
  // can match a row by name exactly, the same way Supplier.name already
  // does — added once the importer needed it, not speculatively in Task 1.
  legalName      String  @unique
  billingAddress String?
  bin            String?
  // Days until an invoice is due. 30 is the ordinary default; Finance can
  // set a different figure per customer.
  paymentDays    Int     @default(30)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  journalLines   JournalLine[]
  openingBalance CustomerOpeningBalance?

  @@index([legalName])
}

model Supplier {
  id String @id @default(uuid())

  name         String  @unique
  contactName  String?
  contactPhone String?
  contactEmail String?
  bin          String?
  paymentDays  Int     @default(30)

  // Retired, not deleted, once it carries a bill — same posture as
  // Account and AssetCategory.
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  journalLines   JournalLine[]
  openingBalance SupplierOpeningBalance?
  bills          SupplierBill[]
  payments       SupplierPayment[]
  creditNotes    SupplierCreditNote[]

  @@index([name])
}

// One row per party: what they owed us, or we owed them, on the day this
// system went live. Not an itemised open invoice/bill — those models don't
// exist until Phase 3, and building throwaway ones now would be wasted
// work. `asOf` is `SALES_GO_LIVE`, the same date for every row.
model CustomerOpeningBalance {
  id         String   @id @default(uuid())
  customerId String   @unique
  customer   Customer @relation(fields: [customerId], references: [id])
  amount     Decimal  @db.Decimal(14, 2)
  asOf       DateTime
  importedBy String
  createdAt  DateTime @default(now())
}

model SupplierOpeningBalance {
  id         String   @id @default(uuid())
  supplierId String   @unique
  supplier   Supplier @relation(fields: [supplierId], references: [id])
  amount     Decimal  @db.Decimal(14, 2)
  asOf       DateTime
  importedBy String
  createdAt  DateTime @default(now())
}

// ── RECEIVABLES & PAYABLES — Phase 2 (Buying) ───────────────────────────────

// Master data (design §2). Three seeded rows cover today's needs; more can
// be added later from a settings screen this phase does not build.
model VatCode {
  id          String  @id @default(uuid())
  code        String  @unique
  name        String
  ratePercent Decimal @db.Decimal(5, 2)
  isActive    Boolean @default(true)

  billLines SupplierBillLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

enum SupplierDocStatus {
  DRAFT
  APPROVED
}

enum BillLineKind {
  GOODS
  SERVICE
}

model SupplierBill {
  id         String   @id @default(uuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])
  // The supplier's own bill number, not this system's id.
  billNumber String
  date       DateTime
  dueDate    DateTime
  currency   Currency @default(BDT)
  // Frozen at the bill date, resolveRateOrThrow(currency, date). Null for
  // a BDT bill, which needs no rate.
  fxRateToBdt Decimal? @db.Decimal(18, 6)

  status     SupplierDocStatus @default(DRAFT)
  approvedBy String?
  approvedAt DateTime?

  lines       SupplierBillLine[]
  allocations SupplierPaymentAllocation[]
  creditNotes SupplierCreditNote[]

  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([supplierId])
  @@index([status])
  @@index([dueDate])
}

model SupplierBillLine {
  id          String       @id @default(uuid())
  billId      String
  bill        SupplierBill @relation(fields: [billId], references: [id], onDelete: Cascade)
  description String
  kind        BillLineKind

  // Always BDT, what actually posts. On a USD bill this is
  // sourceAmount x the bill's frozen fxRateToBdt.
  amount Decimal @db.Decimal(14, 2)
  // The foreign-currency figure, memo only, set only when the bill's
  // currency is not BDT, same pattern as JournalLine.sourceAmount.
  sourceAmount Decimal? @db.Decimal(14, 2)

  vatCodeId String
  vatCode   VatCode @relation(fields: [vatCodeId], references: [id])
  vatAmount Decimal @db.Decimal(14, 2)

  // Required. "There are no untagged lines" — design §2.
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id])

  creditNoteLines SupplierCreditNoteLine[]

  @@index([billId])
  @@index([opportunityId])
}

model SupplierPayment {
  id         String   @id @default(uuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])
  date       DateTime

  // Always BDT, what actually posts to the bank/cash account.
  amount Decimal @db.Decimal(14, 2)
  // The foreign-currency figure, memo only, set only when currency is not
  // BDT, same pattern as SupplierBillLine.sourceAmount.
  sourceAmount Decimal? @db.Decimal(14, 2)
  currency     Currency @default(BDT)
  fxRateToBdt  Decimal? @db.Decimal(18, 6)

  // Cheque number, bank reference, bKash transaction id, same field as
  // OperatingCost.paymentRef.
  reference String?

  status     SupplierDocStatus @default(DRAFT)
  approvedBy String?
  approvedAt DateTime?

  allocations SupplierPaymentAllocation[]

  createdBy String
  createdAt DateTime @default(now())

  @@index([supplierId])
  @@index([status])
}

// "This much of this payment settles this bill." Created for the bills
// picked when the payment is drafted (matchedAt null), and appended to
// later when an advance's unallocated balance is matched to a bill that
// arrives afterward (matchedAt set).
model SupplierPaymentAllocation {
  id        String          @id @default(uuid())
  paymentId String
  payment   SupplierPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  billId    String
  bill      SupplierBill    @relation(fields: [billId], references: [id])

  // Always BDT, the amount this row actually clears against the bill.
  amount Decimal @db.Decimal(14, 2)
  // The USD principal this row settles, set only when the bill is a USD
  // bill, what FX variance is computed against: this same principal at
  // the bill's frozen rate versus the payment's frozen rate.
  amountUsd Decimal?  @db.Decimal(14, 2)
  matchedAt DateTime?

  @@index([paymentId])
  @@index([billId])
}

model SupplierCreditNote {
  id         String       @id @default(uuid())
  billId     String
  bill       SupplierBill @relation(fields: [billId], references: [id])
  supplierId String
  supplier   Supplier     @relation(fields: [supplierId], references: [id])
  date       DateTime
  // Required — design §2, "required reason".
  reason     String

  status     SupplierDocStatus @default(DRAFT)
  approvedBy String?
  approvedAt DateTime?

  lines SupplierCreditNoteLine[]

  createdBy String
  createdAt DateTime @default(now())

  @@index([billId])
  @@index([supplierId])
  @@index([status])
}

model SupplierCreditNoteLine {
  id           String             @id @default(uuid())
  creditNoteId String
  creditNote   SupplierCreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)
  billLineId   String
  billLine     SupplierBillLine   @relation(fields: [billLineId], references: [id])

  // Always BDT, the gross reduction against 2111 for this line.
  amount    Decimal @db.Decimal(14, 2)
  vatAmount Decimal @db.Decimal(14, 2)

  @@index([creditNoteId])
  @@index([billLineId])
}

model JournalAttachment {
  id        String  @id @default(uuid())
  journalId String
  journal   Journal @relation(fields: [journalId], references: [id], onDelete: Cascade)

  // Cloudinary asset ID, not a URL — delivery URLs are signed per request
  // and expire. Same as Document, AssetAttachment and CostAttachment.
  publicId   String   @unique
  fileName   String
  bytes      Int
  format     String
  uploadedBy String?
  uploadedAt DateTime @default(now())

  @@index([journalId, uploadedAt])
}

// ── POSTING RULES ─────────────────────────────
model PostingRule {
  id        String   @id @default(uuid())
  event     String
  key       String
  accountId String
  account   Account  @relation(fields: [accountId], references: [id])
  note      String?
  updatedBy String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([event, key])
  @@index([event])
}

enum CostNature {
  DIRECT
  ADMINISTRATIVE
}

model ExpenseCategory {
  id     String         @id @default(uuid())
  code   String         @unique
  name   String         @unique
  claims ExpenseClaim[]
}

model StatementNote {
  id        String @id @default(uuid())
  ref       String @unique
  title     String
  body      String
  sortOrder Int    @default(0)

  updatedBy String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

// ── SALES ─────────────────────────────────────────────────────────────────
// Always both words, SalesAccount and never Account: Account already means a
// line in the chart of accounts, and the two live in the same application.

enum SalesAccountStatus {
  ACTIVE
  INACTIVE
  // They asked us to stop. Suppresses every reminder without deleting a word
  // of the history.
  DO_NOT_CONTACT
}

model SalesAccount {
  id           String             @id @default(uuid())
  name         String             @unique
  industry     String?
  website      String?
  address      String?
  status       SalesAccountStatus @default(ACTIVE)
  statusReason String?

  /// The one employee answerable for this account. Always set, because
  /// reminders need somewhere to go.
  ownerEmployeeId String
  owner           Employee @relation("SalesAccountOwner", fields: [ownerEmployeeId], references: [id])

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments    SalesAccountAssignment[]
  contacts       SalesContact[]
  communications SalesCommunication[]
  opportunities  Opportunity[]
  meetings       SalesMeeting[]
  tasks          SalesTask[]
  weeklyNotes    WeeklyAccountNote[]

  // Receivables & payables, Phase 1. Set the day this account's first
  // Opportunity is Won (Phase 3 wires the hook); absent for accounts with
  // no won deal yet.
  customer Customer?

  @@index([ownerEmployeeId, status])
  @@index([status])
}

/// The *extra* people on an account. The Owner is SalesAccount.ownerEmployeeId
/// and is deliberately not repeated here: storing the same fact twice means
/// keeping two copies in step forever.
model SalesAccountAssignment {
  id             String       @id @default(uuid())
  salesAccountId String
  salesAccount   SalesAccount @relation(fields: [salesAccountId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee     @relation("SalesAccountAssignee", fields: [employeeId], references: [id])
  assignedBy     String?
  assignedAt     DateTime     @default(now())

  @@unique([salesAccountId, employeeId])
  @@index([employeeId])
}

enum SalesContactStatus {
  UNVERIFIED
  VERIFIED
  UNREACHABLE
  INVALID
}

/// A named person at an account.
///
/// Exactly one contact per account may be primary, and that is enforced in
/// `setPrimaryContact` — one transaction that demotes the old primary before
/// promoting the new one. A partial unique index
/// (`ON ("salesAccountId") WHERE "isPrimary"`) would say it in the database
/// instead, but Prisma cannot express one, so every later
/// `migrate diff --from-config-datasource` would emit a DROP for it and
/// somebody would eventually apply that migration without reading it.
model SalesContact {
  id             String       @id @default(uuid())
  salesAccountId String
  salesAccount   SalesAccount @relation(fields: [salesAccountId], references: [id], onDelete: Cascade)

  name        String
  designation String?
  phone       String?
  email       String?
  isPrimary   Boolean @default(false)

  /// Verified means somebody actually reached them, not that a number was
  /// written down. Cleared when a later attempt proves otherwise: a stale
  /// verification is worse than none.
  status     SalesContactStatus @default(UNVERIFIED)
  verifiedAt DateTime?
  verifiedBy String?

  note      String?
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  communications     SalesCommunication[]
  meetingAttendances SalesMeetingAttendee[]

  @@index([salesAccountId, status])
}

enum SalesChannel {
  CALL
  EMAIL
  WHATSAPP
  OTHER
  // No VISIT: a visit produces Meeting Minutes, so it is a SalesMeeting.
}

/// One entry in an account's Timeline: a call made, an email sent, a message
/// answered.
model SalesCommunication {
  id             String       @id @default(uuid())
  salesAccountId String
  salesAccount   SalesAccount @relation(fields: [salesAccountId], references: [id], onDelete: Cascade)

  /// Optional: plenty of calls are to a switchboard rather than to a named
  /// person. SetNull and not Cascade — deleting a contact must not delete the
  /// record of having spoken to them.
  contactId String?
  contact   SalesContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  channel    SalesChannel
  occurredAt DateTime
  summary    String
  detail     String?

  /// Frozen. Authorship survives reassignment — who made the call does not
  /// change when the account changes hands. A real relation rather than a
  /// loose id, so the Timeline can name the author and an unknown id is
  /// refused by the database instead of stored.
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([salesAccountId, occurredAt])
  @@index([employeeId, occurredAt])
  @@index([contactId])
}

// ── OPPORTUNITIES ─────────────────────────────────────────────────────────
// Phase 2. The part that replaces the spreadsheet.

/// One value on purpose. The Software department workflow is not built, and a
/// door with nothing behind it is worse than no door: it invites a form that
/// cannot be submitted. A second value is a normal migration on the day
/// somebody builds what sits behind it.
enum SalesTrack {
  NETWORKING
  SOFTWARE_DEVELOPMENT
}

/// Did we get it? The outcome. Distinct from Stage, which is the position.
enum OpportunityStatus {
  ONGOING
  WON
  /// A competitor won.
  LOST
  /// Nobody won — the customer shelved it, the budget went. Both LOST and
  /// CANCELLED require a reason; the difference is who ended up with the deal.
  CANCELLED
}

/// How far along, and *who we are waiting on* — which is what makes a stage
/// actionable rather than decorative. Only meaningful while status is ONGOING;
/// on close it freezes at whatever it was, because "lost at Negotiation" and
/// "lost at OEM Pricing" are different businesses and the second one is
/// usually a pricing problem somebody can fix.
///
/// Deliberately an enum and not a settings table: funnel reports need stable
/// buckets, and a configurable list means last quarter's chart silently
/// rewrites itself when somebody edits it.
enum OpportunityStage {
  /// Waiting on us to start. They have said what they need; nothing worked out yet.
  REQUIREMENT_RECEIVED
  /// Waiting on us. Sizing, topology, the HLD if one is being written.
  SOLUTION_DESIGN
  /// Waiting on the OEM. Price, availability, special bid. We cannot quote yet.
  OEM_PRICING
  /// Waiting on the customer. They have our number.
  QUOTATION_SUBMITTED
  /// Both sides. They came back; commercial back-and-forth.
  NEGOTIATION
  /// Waiting on the customer, with nothing left for us to do but chase.
  AWAITING_DECISION
}

model Opportunity {
  id             String       @id @default(uuid())
  /// BS-OPP-00001, from the same IdCounter mechanism issuing employee codes
  /// and asset tags.
  serial         String       @unique
  salesAccountId String
  salesAccount   SalesAccount @relation(fields: [salesAccountId], references: [id], onDelete: Cascade)

  /// The meeting it came out of. The column waited for phase 3, so adding the
  /// relation needed no backfill. SetNull: deleting a meeting must not delete
  /// the deal that came out of it.
  meetingId String?
  meeting   SalesMeeting? @relation("OpportunityOrigin", fields: [meetingId], references: [id], onDelete: SetNull)

  track SalesTrack @default(NETWORKING)

  /// Was `projectName` in the first analysis. Renamed: the business calls it
  /// the Opportunity Name and the examples are "Routing", "Firewall Upgrade" —
  /// not project names.
  name String

  /// The OEM's person handling us. One relationship per deal, not one per
  /// product line, so it sits here and not on the line.
  oemAccountManager String?

  /// THE deal value, and the only figure the dashboard, the funnel and the
  /// quarterly achievement read. Line values are detail beside it and are
  /// never silently synchronised with it. Nullable because an unpriced deal is
  /// a real state and must not be stored as zero.
  amount   Decimal? @db.Decimal(14, 2)
  /// Every deal is in taka today. The column stays and the UI shows no
  /// selector — a control that cannot do anything is a bug — so a future USD
  /// deal is a UI change rather than a migration.
  currency Currency @default(BDT)

  expectedCloseDate DateTime?

  status       OpportunityStatus @default(ONGOING)
  /// Required for LOST and CANCELLED.
  statusReason String?
  /// Set when status leaves ONGOING. This — not updatedAt — is what a
  /// quarter's achievement is counted on.
  closedAt     DateTime?

  stage          OpportunityStage @default(REQUIREMENT_RECEIVED)
  /// Stamped on every stage change, so "stuck in OEM Pricing for 40 days" is
  /// one indexed comparison rather than a scan of the audit log.
  stageChangedAt DateTime         @default(now())

  /// The current intention, of which there is exactly one. Previous next steps
  /// live in the audit log rather than in a table of their own.
  nextStep      String?
  /// Date only, stored at UTC midnight.
  nextStepDueOn DateTime?

  /// Whether this deal's requirement includes software — the weekly report's
  /// Application column (§26.9). Null until somebody answers, because "not
  /// asked yet" and "no software" are different facts.
  softwareNeeded Boolean?

  // ── the funnel (§27) ──

  /// The sheet's Use Case column. Free text with suggestions from prior
  /// values, the same treatment `OpportunityLine.oemBrand` gets and for the
  /// same reason: a closed list would be wrong within a month.
  useCase String?

  /// The date we quoted, date-only at UTC midnight. Stamped when `stage`
  /// first reaches QUOTATION_SUBMITTED, and editable afterwards, because the
  /// real offer date is often earlier than the day somebody updated the
  /// system.
  ///
  /// It also decides funnel membership: a deal is in the funnel exactly when
  /// this is set, and it never leaves (§27.2). One field doing two jobs, said
  /// out loud here rather than discovered later — if a deal ever needs to be
  /// in the funnel without an offer date, that is an `inFunnel` column, not a
  /// sentinel date.
  offeredOn DateTime?

  /// Who took it, at what price, with what — asked for when `status` becomes
  /// LOST (§27.4). Three nullable columns rather than a table: there is one
  /// competitor per lost deal, and a deal is lost once.
  lostToPartner String?
  lostToAmount  Decimal? @db.Decimal(14, 2)
  lostToProduct String?

  /// The person running THIS deal — not necessarily the account's Owner. One
  /// company can have a firewall deal run by one person and a switching deal
  /// run by another. Defaults to the account Owner on create, and must already
  /// have access to the account.
  ownerEmployeeId String
  owner           Employee @relation("OpportunityOwner", fields: [ownerEmployeeId], references: [id])

  /// Stamped once, when status first becomes WON, copied from ownerEmployeeId
  /// as it stood that day. Never moves again — handing an account over next
  /// year changes who works it from then on; it does not rewrite who closed
  /// what last March. This, not ownerEmployeeId, is what achievement counts.
  /// Restrict, not the default SET NULL an optional relation would get: this
  /// credit is a historical fact, and a cascade that quietly nulls it is the
  /// one way it could "move" after all. Nothing deletes employees today, so
  /// this constrains a path that does not exist yet rather than an existing one.
  wonByEmployeeId String?
  wonBy           Employee? @relation("OpportunityWonBy", fields: [wonByEmployeeId], references: [id], onDelete: Restrict)

  lastActivityAt DateTime @default(now())
  createdBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  lines    OpportunityLine[]
  /// Meetings about this deal (SalesMeeting.opportunityId).
  meetings SalesMeeting[]    @relation("MeetingOpportunity")
  tasks    SalesTask[]

  // Receivables & payables, Phase 1: the back-relation for
  // JournalLine.opportunityId. Empty until Phase 2/3 post against a deal.
  journalLines JournalLine[]
  // Receivables & payables, Phase 2: every Supplier Bill line bought for
  // this deal. "There are no untagged lines" — design §2.
  supplierBillLines SupplierBillLine[]

  @@index([salesAccountId])
  @@index([status, expectedCloseDate])
  @@index([ownerEmployeeId, status])
  @@index([status, lastActivityAt])
  @@index([status, stage])
  /// The quarterly achievement query.
  @@index([wonByEmployeeId, closedAt])
  /// The funnel's own query, and the only one it runs per person: the deals
  /// this employee has quoted, newest offer first (§27.6). Equality column
  /// first, range/sort column second. Added with the query rather than on
  /// theory — an index that never shows up in a plan is pure write cost.
  @@index([ownerEmployeeId, offeredOn])
}

/// Products, models, quantities and values. An Opportunity may hold several,
/// which is why one text field could not carry it.
model OpportunityLine {
  id            String      @id @default(uuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  /// Free text with suggestions from prior values — the same treatment the OEM
  /// brand gets, for the same reason: a closed list would be wrong within a
  /// month and nobody would be able to record the deal they actually have.
  product       String
  oemBrand      String?
  model         String?
  /// Nullable because some lines are services, not units.
  quantity      Int?
  unitValue     Decimal? @db.Decimal(14, 2)
  /// Never derived silently from quantity × unitValue. A number written
  /// without being asked for is the same defect as a faked one; the interface
  /// offers to fill it and a person presses the button.
  lineValue     Decimal? @db.Decimal(14, 2)
  /// The profit on this product, as a percentage of `lineValue`, typed by a
  /// person: -100 to 100, negative for one sold at a loss. The taka figure is
  /// worked out when read (sales.margin.ts), so it follows the Total price;
  /// the deal's margin is these added up. Null is "no margin yet", never 0%.
  marginPercent Decimal? @db.Decimal(5, 2)
  note          String?
  order         Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([opportunityId, order])
}

/// The same rows render as **Remarks** on a Sales Account and **Comments** on
/// an Opportunity. That is the business's own vocabulary and the two labels
/// must not be made consistent with each other.
enum SalesCommentKind {
  /// The employee's own words.
  GENERAL
  /// What the customer said. Offered only on an Opportunity, because feedback
  /// is always about a specific deal.
  CUSTOMER_FEEDBACK
  /// Written by management, usually during a Saturday funnel review.
  MANAGEMENT_NOTE
}

/// Polymorphic, exactly as AuditLog and Event already are — so there is no FK
/// to the target and no join table per entity type.
model SalesComment {
  /// "SALES_ACCOUNT" | "OPPORTUNITY" today. "SALES_MEETING" | "SALES_TASK" |
  /// "PROJECT" | "WEEKLY_REPORT" arrive with the tables they name.
  id       String           @id @default(uuid())
  entity   String
  entityId String
  kind     SalesCommentKind
  body     String

  /// The authenticated author. This is the durable identity used for edit
  /// ownership and also supports Super Admin, who intentionally has no
  /// Employee row. The Employee relation remains when one exists so sales
  /// feeds can use HR's canonical staff name.
  authorUserId     String
  authorUser       User      @relation(fields: [authorUserId], references: [id], onDelete: Restrict)
  authorEmployeeId String?
  /// Restrict, as the table was created. Making the column optional
  /// (20260909170000) left the key as it was, and without saying so here
  /// Prisma assumes SET NULL and every later diff tries to change it.
  author           Employee? @relation(fields: [authorEmployeeId], references: [id], onDelete: Restrict)

  /// Set when the comment was written during a Saturday review, which makes
  /// "what did management say about this deal last week" one query. Phase 6
  /// gave it its relation. SetNull: deleting a meeting must not delete what
  /// was said in it — the note belongs to the deal.
  funnelMeetingId String?
  funnelMeeting   FunnelMeeting? @relation(fields: [funnelMeetingId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([entity, entityId, createdAt])
  @@index([funnelMeetingId, createdAt])
  @@index([authorUserId])
}

/// One row per person per quarter. Absent means no target was set — which the
/// dashboard shows as *not set*, never as a target of zero.
model SalesTarget {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  /// Calendar, not financial. Named so it cannot be mistaken for the ledger's
  /// year, which starts in July. Sales counts January to March as Q1 and the
  /// ledger does not; anything putting the two figures side by side has to say
  /// which year it means.
  calendarYear Int

  /// Taka of deal value to win in the year. Split equally over the quarters
  /// from `startQuarter` to Q4, with a quarter's shortfall carried into the
  /// next — worked out in target.plan.ts and never stored per quarter, so a
  /// correction to a past quarter's wins moves the later targets with it.
  amount       Decimal @db.Decimal(14, 2)
  /// 1-4. Somebody who joins in July starts in Q3 and is not measured
  /// against the quarters before they arrived.
  startQuarter Int     @default(1)
  note         String?
  setBy        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, calendarYear])
  @@index([calendarYear])
}

/// Where a meeting happens. A visit is a meeting at the customer's site, not a
/// SalesCommunication (revision M10).
enum SalesMeetingMode {
  CUSTOMER_SITE
  OUR_OFFICE
  ONLINE
}

enum SalesMeetingStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum SalesMeetingSide {
  OURS
  THEIRS
}

/// A meeting with a customer: a visit, a meeting at our office, or one online.
/// Rescheduling is editing `scheduledAt`; there is no RESCHEDULED status,
/// because a moved meeting is a fact for the Timeline, not a state.
model SalesMeeting {
  id             String       @id @default(uuid())
  salesAccountId String
  salesAccount   SalesAccount @relation(fields: [salesAccountId], references: [id], onDelete: Cascade)
  /// The deal it is about. Optional: a first meeting often comes before any deal.
  opportunityId  String?
  opportunity    Opportunity? @relation("MeetingOpportunity", fields: [opportunityId], references: [id], onDelete: SetNull)

  title       String
  mode        SalesMeetingMode @default(CUSTOMER_SITE)
  scheduledAt DateTime
  endsAt      DateTime?
  /// An address or a room, or for an ONLINE meeting the link.
  location    String?
  notes       String?

  status       SalesMeetingStatus @default(SCHEDULED)
  /// Required to cancel.
  cancelReason String?
  /// A short note on how it went. Full minutes arrive in phase 4.
  outcome      String?
  completedAt  DateTime?

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attendees  SalesMeetingAttendee[]
  /// Deals that came out of this meeting (Opportunity.meetingId).
  originated Opportunity[]          @relation("OpportunityOrigin")
  tasks      SalesTask[]
  /// The meeting minutes, once somebody starts them (phase 4).
  minutes    SalesMeetingMinutes?

  @@index([salesAccountId, scheduledAt])
  /// The 00:01 daily email reads this.
  @@index([status, scheduledAt])
  @@index([opportunityId])
}

/// Who attends. Our side is an employee; their side is a saved contact of the
/// account or, when they are not saved, a typed name.
model SalesMeetingAttendee {
  id          String           @id @default(uuid())
  meetingId   String
  meeting     SalesMeeting     @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  side        SalesMeetingSide
  employeeId  String?
  employee    Employee?        @relation(fields: [employeeId], references: [id])
  contactId   String?
  contact     SalesContact?    @relation(fields: [contactId], references: [id], onDelete: SetNull)
  name        String?
  designation String?

  @@index([meetingId])
  @@index([employeeId])
}

enum SalesTaskOrigin {
  /// The employee planned it: the first plan's follow-up.
  SELF
  /// Management gave it at a Saturday funnel meeting (phase 6).
  FUNNEL_MEETING
}

enum SalesTaskPriority {
  LOW
  NORMAL
  HIGH
}

enum SalesTaskStatus {
  PENDING
  DONE
  CANCELLED
}

/// Something one person must do by a date, with a reminder. One table for both
/// an employee's own follow-ups and, from phase 6, the funnel meeting's action
/// items (revision M3): two task systems is the mistake §41 warns about.
model SalesTask {
  id     String          @id @default(uuid())
  origin SalesTaskOrigin @default(SELF)

  /// Required by the service in phase 3, so every task is on an account's
  /// Timeline. Nullable in the table because a phase 5 project task may not
  /// belong to an account.
  salesAccountId  String?
  salesAccount    SalesAccount?  @relation(fields: [salesAccountId], references: [id], onDelete: Cascade)
  opportunityId   String?
  opportunity     Opportunity?   @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  meetingId       String?
  meeting         SalesMeeting?  @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  /// Phase 5 will add this relation. The column exists now, so that will be a
  /// relation change and not a backfill.
  projectId       String?
  /// Phase 6 made good on the other half: an action item given at a Saturday
  /// review (§27.13). SetNull, not Cascade — deleting a meeting must not
  /// delete the work it handed out.
  funnelMeetingId String?
  funnelMeeting   FunnelMeeting? @relation(fields: [funnelMeetingId], references: [id], onDelete: SetNull)

  title    String
  detail   String?
  /// Date only, UTC midnight: the house convention.
  dueOn    DateTime
  priority SalesTaskPriority @default(NORMAL)

  assignedToEmployeeId String
  assignedTo           Employee  @relation("SalesTaskAssignee", fields: [assignedToEmployeeId], references: [id])
  /// Null for a task the person made for themselves.
  assignedByEmployeeId String?
  assignedBy           Employee? @relation("SalesTaskAssigner", fields: [assignedByEmployeeId], references: [id])

  status       SalesTaskStatus @default(PENDING)
  outcome      String?
  /// Required to cancel.
  cancelReason String?
  completedAt  DateTime?
  completedBy  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, dueOn])
  @@index([assignedToEmployeeId, status, dueOn])
  @@index([funnelMeetingId])
  @@index([salesAccountId, status])
}

/// Where a minutes document stands. Stored rather than worked out, because
/// it moves in only two places: a save and a send (revision §25.28).
enum SalesMinutesStatus {
  DRAFT
  SENT
  /// Saved since it was last sent, so it may need sending again.
  EDITED_AFTER_SENDING
}

/// What a section of the minutes holds (§25.18). Only these, because the
/// real documents use only these and the PDF knows how to print each.
enum SalesMinutesSectionKind {
  PARAGRAPHS
  /// Two levels deep, • and o.
  BULLETS
  /// Numbered sub-topics (2.1, 2.2), each with a line of text and bullets.
  SUBTOPICS
  /// The Next Steps table. Its columns are fixed: SL, Action Item,
  /// Responsible Person/Team, Status (§25.19, §25.21).
  TABLE
  /// Formatted text: the Word-style toolbar's document (the owner's change,
  /// 2026-09-15). Stored as Tiptap JSON, checked against a fixed list of
  /// nodes and marks by minutes.content.ts.
  RICH
}

/// The written record of a completed meeting, sent to the customer (§25).
/// The header is read live from the meeting, so none of it is copied here;
/// each sent PDF is the frozen copy.
model SalesMeetingMinutes {
  id        String       @id @default(uuid())
  meetingId String       @unique
  meeting   SalesMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  /// Typed: the meeting has nothing to read it from.
  purpose          String?
  /// An extra line after the account under Meeting With, like "IT Department".
  meetingWithNote  String?
  /// The requirement fork (§25.6), asked only when the meeting has no deal.
  /// Null until answered; fixed once the minutes are first sent.
  requirementFound Boolean?

  status     SalesMinutesStatus @default(DRAFT)
  lastSentAt DateTime?

  /// User ids, so a Super Admin, who has no employee record, can write them.
  createdBy String
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sections  SalesMinutesSection[]
  preparers SalesMinutesPreparer[]
  sends     SalesMinutesSend[]

  @@index([status])
}

/// One numbered section. The number is its position, worked out when printed,
/// so two sections can never both be "3." (the first plan's R6).
model SalesMinutesSection {
  id        String                  @id @default(uuid())
  minutesId String
  minutes   SalesMeetingMinutes     @relation(fields: [minutesId], references: [id], onDelete: Cascade)
  order     Int
  heading   String
  kind      SalesMinutesSectionKind
  /// Shaped by `kind`, and checked by minutes.content.ts on every save.
  content   Json

  @@index([minutesId, order])
}

/// Who is named under Prepared by. Their HR job title is read live; the
/// extra line ("Cloud & Cybersecurity") belongs to this document only.
model SalesMinutesPreparer {
  id         String              @id @default(uuid())
  minutesId  String
  minutes    SalesMeetingMinutes @relation(fields: [minutesId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee            @relation(fields: [employeeId], references: [id])
  titleExtra String?
  order      Int                 @default(0)

  @@unique([minutesId, employeeId])
}

/// One press of "Download for sending": the exact file that went out, kept in
/// the file store. A document can be sent again after edits, so there is one
/// row per send and every copy stays (§25.25).
model SalesMinutesSend {
  id        String              @id @default(uuid())
  minutesId String
  minutes   SalesMeetingMinutes @relation(fields: [minutesId], references: [id], onDelete: Cascade)
  sentAt    DateTime            @default(now())
  /// The user who pressed the button.
  sentBy    String
  /// Typed and optional: "Md. Salim Reza, by email".
  sentTo    String?
  /// The file store's id for the kept copy.
  fileId    String
  fileName  String

  @@index([minutesId, sentAt])
}

/// Where a weekly report stands (§26.4). Draft until it is submitted; adding
/// to a submitted week puts it back to Draft and keeps the old PDF.
enum WeeklyReportStatus {
  DRAFT
  SUBMITTED
}

/// One Sales User's account of one working week (§26). The week is mostly a
/// view of work recorded elsewhere, so this table holds only what the week
/// itself owns: where it stands, when it was submitted, and whether that was
/// late. Created the first time the week is written to, never by a job.
model WeeklyReport {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  /// The Sunday of the week, date-only at UTC midnight — the convention leave
  /// and attendance already follow.
  weekStart  DateTime

  status           WeeklyReportStatus @default(DRAFT)
  /// The first submit, and whether it was after the deadline. Both frozen: a
  /// week reopened and submitted again keeps its on-time mark (§26.4).
  firstSubmittedAt DateTime?
  submittedLate    Boolean            @default(false)
  lastSubmittedAt  DateTime?

  /// The user id, so a report can be traced to the sign-in that wrote it.
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  copies    WeeklyReportCopy[]
  notes     WeeklyAccountNote[]
  otherWork WeeklyOtherWork[]

  @@unique([employeeId, weekStart])
  @@index([weekStart, status])
}

/// One press of Submit: the exact PDF management read, kept in the file store.
/// A reopened week can be submitted again, so every copy stays (§26.17), as a
/// minutes send does.
model WeeklyReportCopy {
  id             String       @id @default(uuid())
  weeklyReportId String
  weeklyReport   WeeklyReport @relation(fields: [weeklyReportId], references: [id], onDelete: Cascade)
  submittedAt    DateTime     @default(now())
  /// The user who pressed Submit.
  submittedBy    String
  /// The file store's id for the kept copy.
  fileId         String
  fileName       String

  @@index([weeklyReportId, submittedAt])
}

/// What the week adds to one account on one day: the two things the Sales Hub
/// has no home for, and a next step for an account with no deal (§26.7, §26.8).
/// Everything else in the row is read from where it already lives.
model WeeklyAccountNote {
  id             String       @id @default(uuid())
  weeklyReportId String
  weeklyReport   WeeklyReport @relation(fields: [weeklyReportId], references: [id], onDelete: Cascade)
  /// Date only, UTC midnight. Inside the report's week, the optional Saturday
  /// included.
  date           DateTime
  salesAccountId String
  salesAccount   SalesAccount @relation(fields: [salesAccountId], references: [id], onDelete: Cascade)

  /// The salesperson's own obstacle that day.
  challenges String?
  /// A shortfall on our company's side.
  gap        String?
  /// Only while the account has no open deal; with one, the deal's own
  /// nextStep is shown and this stays null (§26.9).
  nextStep   String?
  /// The task the next step became, when it was ticked. A plain id, as the
  /// minutes' Next Steps rows keep theirs: the task has its own life, and
  /// deleting one must not take this note with it.
  taskId     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([weeklyReportId, date, salesAccountId])
  @@index([salesAccountId, date])
}

/// Work with no Sales Account behind it: an office discussion, learning, an
/// HLD, documentation. A day and the person's own words, with no kinds to
/// pick (§26.11).
model WeeklyOtherWork {
  id             String       @id @default(uuid())
  weeklyReportId String
  weeklyReport   WeeklyReport @relation(fields: [weeklyReportId], references: [id], onDelete: Cascade)
  /// Date only, UTC midnight.
  date           DateTime
  text           String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([weeklyReportId, date])
}

/// The minutes template, on Sales Settings (§25.20, §25.30). One row, id 1,
/// and no row means the default template. Changes reach new minutes only.
model SalesMinutesTemplate {
  id        Int      @id @default(1)
  /// [{ heading, kind, startsWithOutcome? }], checked by minutes.content.ts.
  sections  Json
  updatedBy String?
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────
// The funnel (§27)
//
// The funnel itself is not a table. It is a view over deals that have been
// quoted — `Opportunity.offeredOn IS NOT NULL` — so nothing here stores a
// copy of a deal, and editing a funnel cell writes to the deal (§27.7).
// What these three tables hold is the *meeting*: when it happened, who was
// there, and whose funnel got walked.
// ─────────────────────────────────────────────────────────────────────────

/// One Saturday review.
model FunnelMeeting {
  id String @id @default(uuid())

  /// The Sunday of the week being reviewed, date-only at UTC midnight — the
  /// same convention WeeklyReport, leave and attendance follow.
  ///
  /// Unique: one review per week. Two meetings for one week would split the
  /// reviewed ticks between them and neither would be the answer.
  weekStart DateTime @unique

  /// The day it was actually held, which is usually but not always the
  /// Saturday after `weekStart`. Stored because "we did last week's funnel on
  /// the Monday" is a real thing that happens and the date should say so.
  heldOn DateTime

  status FunnelMeetingStatus @default(SCHEDULED)

  /// Who ran it. An Employee rather than a User id, because this is a person
  /// in the room, and the team list is drawn from Employee.
  ranByEmployeeId String
  ranBy           Employee @relation("FunnelMeetingRanBy", fields: [ranByEmployeeId], references: [id])

  /// One free note for the week — not per person. Per-person and per-deal
  /// words are SalesComment rows carrying `funnelMeetingId` (§27.8).
  note String?

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attendees FunnelMeetingAttendee[]
  reviews   FunnelMeetingReview[]
  /// Action items handed out here (§27.13), and notes written here (§27.8).
  tasks     SalesTask[]
  comments  SalesComment[]

  @@index([status, heldOn])
}

/// Who was in the room.
model FunnelMeetingAttendee {
  id              String        @id @default(uuid())
  funnelMeetingId String
  funnelMeeting   FunnelMeeting @relation(fields: [funnelMeetingId], references: [id], onDelete: Cascade)
  employeeId      String
  employee        Employee      @relation("FunnelMeetingAttendee", fields: [employeeId], references: [id])

  createdAt DateTime @default(now())

  @@unique([funnelMeetingId, employeeId])
  @@index([employeeId])
}

/// The per-person "their funnel was walked" mark.
///
/// **Deliberately not the same thing as attendance** (§27.3). Somebody can be
/// away and their deals still reviewed, and somebody can sit through the whole
/// meeting without their own funnel being opened. Collapsing the two would
/// make both answers wrong.
///
/// A row rather than a boolean, so "reviewed" carries when, and by whom.
model FunnelMeetingReview {
  id              String        @id @default(uuid())
  funnelMeetingId String
  funnelMeeting   FunnelMeeting @relation(fields: [funnelMeetingId], references: [id], onDelete: Cascade)
  /// Whose funnel was walked.
  employeeId      String
  employee        Employee      @relation("FunnelMeetingReviewSubject", fields: [employeeId], references: [id])

  reviewedAt DateTime @default(now())
  /// The user id of whoever ticked it.
  reviewedBy String?

  @@unique([funnelMeetingId, employeeId])
  @@index([employeeId, reviewedAt])
}

enum FunnelMeetingStatus {
  SCHEDULED
  /// Takes no new notes and no new action items, and locks nothing already
  /// written. Reopening is ordinary, not an exception (§27.11) — which is why
  /// this is an enum and not a boolean: the audit log can then tell "reopened"
  /// from "never completed".
  COMPLETED
}
